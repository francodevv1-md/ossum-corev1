# Project-local GGA configuration. The shared pre-commit hook reviews staged files only.
PROVIDER="opencode"
FILE_PATTERNS="*.ts,*.tsx,*.js,*.jsx,*.css,*.json,*.prisma,*.md"
EXCLUDE_PATTERNS="*.test.*,*.spec.*,*.d.ts,dist/*,build/*,node_modules/*,.next/*,.engram/*,knowledge/archive/*"
RULES_FILE="AGENTS.md"
STRICT_MODE="true"
TIMEOUT="300"
OPENCODE_AGENT="gga-reviewer"
