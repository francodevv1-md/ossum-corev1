":"4d0413b5331addf46b19bf14c25263b6d72dbe282122d107b812458caf9dcaba","rawSha256":"df9ef74276ea7616b6914f078d5b821f509665e9521c4e23e7911f400fa26f4c","startByte":1836}],"rawSha256":"231fe2e2261617bf8c9302da806ef23705dcbb18545839848e4b2c41ddb8a01f","roundTripRule":"concat(ast.losslessChildren[*].utf8Base64 decoded in ordinal order) MUST equal exact fragment bytes","semanticAstContractUtf8":"AST inventory: declaration `v_valid:boolean`; SELECT root `EXISTS(query)`; JOIN roots `policy(3),context(2),lot(3),unit(3)`; WHERE root `AND[eligibility company/article/id/current-policy,policy eligible/trace/unit/scale,OR[NONE(3),LOT(4),IDENTIFIED_UNIT(4)]]`; IF root `IS_TRUE(v_valid)`; outcomes `RETURN_NEW`, `ELSE_RAISE`; one R0001. READS exactly `StockArticleEligibility,StockArticlePolicyVersion,StockContext,StockLot,StockIdentifiedUnit`.","source":{"endByte":22424,"path":"knowledge/specs/STOCK-CAJAS-C14-SIMPLIFICATION-001/RENDERING_COMPLETION_PROPOSAL.md","startByte":20139},"v2ObjectBlockSha256":"95b3d33d48e2b6ae686f43287524baec05369a1519e74d34e87eabe1b1e7477a"},"schemaVersion":"C14-SIMPLIFICATION-OBJECT-BLOCK-V2","semanticCore":{"candidateApprovalStatus":"PENDING_FRANCO_SINGLE_FINAL_APPROVAL","decisionId":"SC05","executionAuthority":false,"renderingCompletionDecisionRange":"RC01-RC12","renderingCompletionGitBlob":"d9e8aa22b2ae815326e4cafa24221d198733d87a","renderingCompletionPassObservation":5041,"renderingCompletionRawSha256":"97f586467da19b77ebf2d966acc8202f7fde1824e19f59cf19690e689f88b735","semanticCellUtf8":"| `SC05 / 04 / function:fn_stock_position_parent_guard` | `StockPosition`; `GUARD`, family `ROW_OR_CROSS_ROW_GUARD`. `v_valid` is true exactly when the selected same-company Article eligibility/policy/context exists; trace `NONE/LOT/IDENTIFIED_UNIT` has exactly the SC02 axis; a LOT position resolves its same-company Article lot; an IDENTIFIED_UNIT position resolves its same-company identified unit; and `stockUnit/quantityScale` equal the owning policy values. | READS exact C13 relations `StockArticleEligibility`, `StockArticlePolicyVersion`, `StockContext`, `StockLot`, `StockIdentifiedUnit`; no WRITES. | One IF: `IS_TRUE→RETURN_NEW`, `ELSE→RAISE`; one R0001. Called for INSERT/UPDATE. Full body, query predicates, IF, return, raise, and declaration locators. `C13,CX04W,DT` |","semanticSourceKind":"SC01_SC65_CANDIDATE"},"sourceSemanticSha256":"cfa176102bb43c374f57c6de197378219fd3c29c215bb82fdb2be892bb35273c"}
