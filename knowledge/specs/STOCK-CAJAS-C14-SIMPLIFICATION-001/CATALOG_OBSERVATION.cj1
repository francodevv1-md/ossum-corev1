mmelijvspi","connectionProfile":{"database":"postgres","fragment":"","host":"aws-1-sa-east-1.pooler.supabase.com","port":5432,"projectRef":"yywqcdromnmmelijvspi","protocol":"postgresql:","query":"","schemaVersion":"C14-SIMPLIFICATION-CONNECTION-PROFILE-V1","tier":"development","tlsMode":"verify-full","username":"postgres.yywqcdromnmmelijvspi"},"connectionProfileSha256":"6d18bf936839ed37ed46bdb631e706b8ab32912746ca41a4c5a8fd2b01f163b6","systemIdentifier":"7642734024280108049","databaseOid":"5","databaseName":"postgres","serverVersionNum":"170006","serverVersion":"PostgreSQL 17.6 on aarch64-unknown-linux-gnu, compiled by gcc (GCC) 15.2.0, 64-bit","currentUserOid":"16388","currentUserName":"postgres"},"transactionMode":"READ_ONLY_REPEATABLE_READ","transactionSnapshotIdentity":"13185:13185:","observedAt":"2026-08-13T19:46:21.491Z","queryArtifacts":[{"schemaVersion":"C14C-QUERY-ARTIFACT-V1","queryId":"Q01_TARGET_IDENTITY","sqlUtf8Lf":"SELECT c.system_identifier::text AS system_identifier,d.oid::text AS database_oid,d.datname::text AS database_name,current_setting('server_version_num') AS server_version_num,version() AS server_version,r.oid::text AS current_user_oid,r.rolname::text AS current_user_name,pg_current_snapshot()::text AS transaction_snapshot_identity,to_char(transaction_timestamp() AT TIME ZONE 'UTC','YYYY-MM-DD\"T\"HH24:MI:SS.MS\"Z\"') AS observed_at FROM pg_catalog.pg_control_system() AS c JOIN pg_catalog.pg_database AS d ON d.datname=current_database() JOIN pg_catalog.pg_roles AS r ON r.rolname=current_user;\u000a","contract":{"columns":["system_identifier","database_oid","database_name","server_version_num","server_version","current_user_oid","current_user_name","transaction_snapshot_identity","observed_at"],"min":1,"max":1,"relations":["pg_control_system","pg_database","pg_roles"]},"sqlRawSha256":"953be69cf157343123fb0e84cd3788163d01b40c49b09d5cee09931370f401a7","queryArtifactSha256":"5985ab2c3a778893db5c3a52bbc0ce608ab13de4ae6c65f00f5b70481e5bcd08"},{"schemaVersion":"C14C-QUERY-ARTIFACT-V1","queryId":"Q02_AVAILABLE_EXTENSION","sqlUtf8Lf":"SELECT name::text AS name,default_version::text AS default_version,installed_version::text AS installed_version FROM pg_catalog.pg_available_extensions WHERE name='btree_gist' ORDER BY name COLLATE \"C\";\u000a","contract":{"columns":["name","default_version","installed_version"],"min":0,"max":1,"relations":["pg_available_extensions"]},"sqlRawSha256":"298fcd0c19da57ce63ff27c731f2b3ee8cc6f263e5afda8a176567243b1545e8","queryArtifactSha256":"2c2dcf7179d068b50f898d7a7610c962adc6d62e2e15ec6b6a5e84653ab0eedb"},{"schemaVersion":"C14C-QUERY-ARTIFACT-V1","queryId":"Q03_AVAILABLE_VERSIONS","sqlUtf8Lf":"SELECT name::text AS name,version::text AS version,CASE WHEN installed THEN 't' ELSE 'f' END AS installed,CASE WHEN superuser THEN 't' ELSE 'f' END AS superuser,CASE WHEN trusted THEN 't' ELSE 'f' END AS trusted,CASE WHEN relocatable THEN 't' ELSE 'f' END AS relocatable,schema::text AS schema,requires::text AS requires FROM pg_catalog.pg_available_extension_versions WHERE name='btree_gist' ORDER BY name COLLATE \"C\",version COLLATE \"C\";\u000a","contract":{"columns":["name","version","installed","superuser","trusted","relocatable","schema","requires"],"min":0,"max":null,"relations":["pg_available_extension_versions"]},"sqlRawSha256":"2d3801671e2f1b2f165b47c923c3e51087f4b776f20dfc1205dfeb8f2c73f43f","queryArtifactSha256":"e7ee73309cf883f0d46dea02cf127b3e49e19ebb3f391d40e22753bc32bd6a68"},{"schemaVersion":"C14C-QUERY-ARTIFACT-V1","queryId":"Q04_INSTALLED_OWNER_REQUIRES","sqlUtf8Lf":"SELECT e.extname::text AS extension_name,e.extversion::text AS installed_version,n.nspname::text AS namespace,CASE WHEN v.relocatable THEN 't' WHEN v.relocatable IS FALSE THEN 'f' ELSE NULL END AS relocatable,e.extowner::text AS owner_oid,r.rolname::text AS owner_name,re.extname::text AS required_name,re.extversion::text AS required_installed_version,rn.nspname::text AS required_namespace FROM pg_catalog.pg_extension AS e JOIN pg_catalog.pg_namespace AS n ON n.oid=e.extnamespace JOIN pg_catalog.pg_roles AS r ON r.oid=e.extowner LEFT JOIN pg_catalog.pg_available_extension_versions AS v ON v.name=e.extname AND v.version=e.extversion LEFT JOIN pg_catalog.pg_depend AS dep ON dep.classid='pg_catalog.pg_extension'::regclass AND dep.objid=e.oid AND dep.refclassid='pg_catalog.pg_extension'::regclass LEFT JOIN pg_catalog.pg_extension AS re ON re.oid=dep.refobjid LEFT JOIN pg_catalog.pg_namespace AS rn ON rn.oid=re.extnamespace WHERE e.extname='btree_gist' ORDER BY e.extname COLLATE \"C\",re.extname COLLATE \"C\" NULLS FIRST;\u000a","contract":{"columns":["extension_name","installed_version","namespace","relocatable","owner_oid","owner_name","required_name","required_installed_version","required_namespace"],"min":0,"max":null,"relations":["pg_extension","pg_namespace","pg_roles","pg_available_extension_versions","pg_depend"]},"sqlRawSha256":"346c688d26d5cab2c82ca28b81a28794d635e544e1418680193238db783a6ad6","queryArtifactSha256":"5687870d1fc9917a51ac82477c6cb25a0c88e10b916c2b5d6974a2a851178b57"},{"schemaVersion":"C14C-QUERY-ARTIFACT-V1","queryId":"Q05_PRIVILEGES","sqlUtf8Lf":"SELECT CASE WHEN has_database_privilege(current_user,current_database(),'CREATE') THEN 't' ELSE 'f' END AS database_create,CASE WHEN has_schema_privilege(current_user,'public','USAGE') THEN 't' ELSE 'f' END AS public_usage,CASE WHEN has_schema_privilege(current_user,'public','CREATE') THEN 't' ELSE 'f' END AS public_create,CASE WHEN r.rolsuper THEN 't' ELSE 'f' END AS current_user_superuser FROM pg_catalog.pg_roles AS r WHERE r.rolname=current_user;\u000a","contract":{"columns":["database_create","public_usage","public_create","current_user_superuser"],"min":1,"max":1,"relations":["pg_roles"]},"sqlRawSha256":"03fbdfc6ef5d72693daeb7e4d92062423faced3f055336e3e26834b080bb6dd0","queryArtifactSha256":"3213f83e227a35867651b2f1c0161707c1a9315929dacd90990cef11bc79e37e"},{"schemaVersion":"C14C-QUERY-ARTIFACT-V1","queryId":"Q06_OPCLASS","sqlUtf8Lf":"SELECT n.nspname::text AS schema,o.opcname::text AS name,a.amname::text AS access_method,(tn.nspname||'.'||t.typname)::text AS input_type,e.extname::text AS extension_name,d.deptype::text AS dependency_type FROM pg_catalog.pg_opclass AS o JOIN pg_catalog.pg_namespace AS n ON n.oid=o.opcnamespace JOIN pg_catalog.pg_am AS a ON a.oid=o.opcmethod JOIN pg_catalog.pg_type AS t ON t.oid=o.opcintype JOIN pg_catalog.pg_namespace AS tn ON tn.oid=t.typnamespace LEFT JOIN pg_catalog.pg_depend AS d ON d.classid='pg_catalog.pg_opclass'::regclass AND d.objid=o.oid AND d.refclassid='pg_catalog.pg_extension'::regclass LEFT JOIN pg_catalog.pg_extension AS e ON e.oid=d.refobjid WHERE n.nspname='public' AND o.opcname='gist_text_ops' AND a.amname='gist' AND tn.nspname='pg_catalog' AND t.typname='text' ORDER BY n.nspname COLLATE \"C\",o.opcname COLLATE \"C\",a.amname COLLATE \"C\",tn.nspname COLLATE \"C\",t.typname COLLATE \"C\",e.extname COLLATE \"C\" NULLS FIRST,d.deptype NULLS FIRST;\u000a","contract":{"columns":["schema","name","access_method","input_type","extension_name","dependency_type"],"min":0,"max":null,"relations":["pg_opclass","pg_namespace","pg_am","pg_type","pg_depend","pg_extension"]},"sqlRawSha256":"2baa2018a7be381ffd076b57e067b53a2fcca71b70070c94022d947f4555e844","queryArtifactSha256":"371bfc13351d4e72450fefced27276a179e6bfd613366efc60e30b05036326b2"}],"queryResults":[[{"rowOrdinal":1,"cells":[{"columnOrdinal":1,"columnName":"system_identifier","isNull":false,"valueUtf8":"7642734024280108049"},{"columnOrdinal":2,"columnName":"database_oid","isNull":false,"valueUtf8":"5"},{"columnOrdinal":3,"columnName":"database_name","isNull":false,"valueUtf8":"postgres"},{"columnOrdinal":4,"columnName":"server_version_num","isNull":false,"valueUtf8":"170006"},{"columnOrdinal":5,"columnName":"server_version","isNull":false,"valueUtf8":"PostgreSQL 17.6 on aarch64-unknown-linux-gnu, compiled by gcc (GCC) 15.2.0, 64-bit"},{"columnOrdinal":6,"columnName":"current