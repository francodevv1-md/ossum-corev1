model DigitalReceipt {
  id                  String                   @id @default(cuid())
  companyId           String
  surgeryId           String
  receiptNumber       String
  status              DigitalReceiptStatus
  issuedAt            DateTime
  issuedBy            Json?
  signedAt            DateTime?
  expiredAt           DateTime?
  revokedAt           DateTime?
  latestAccessVersion Int?
  activeAccessId      String?                  @unique
  currentSignerRole   DigitalReceiptSignerRole
  signers             Json
  latestSnapshotId    String?                  @unique
  metadata            Json?
