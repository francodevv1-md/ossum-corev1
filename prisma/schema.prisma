model Article {
  id               String   @id @default(cuid())
  organizationId   String
  sku              String
  description      String   @db.Text
  articleType      String?
  brand            String?
  manufacturer     String?
  family           String?
  categoryId       String?  @map("category_id")
  clinicalFamilyId String?  @map("clinical_family_id")
  brandId          String?  @map("brand_id")
  manufacturerId   String?  @map("manufacturer_id")
  productLineId    String?  @map("product_line_id")
  modelVariant     String?
  measure          String?
  unit             String   @default("u")
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @db.Timestamptz(6)

  organization        Organization                @relation("OrganizationArticles", fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_article_organization")
  category            ProductCategory?            @relation("ArticleCategory", fields: [organizationId, categoryId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade, map: "fk_article_category")
  clinicalFamily      ClinicalFamily?             @relation("ArticleClinicalFamily", fields: [organizationId, clinicalFamilyId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade, map: "fk_article_clinical_family")
  brandCatalog        Brand?                      @relation("ArticleBrand", fields: [organizationId, brandId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade, map: "fk_article_brand")
