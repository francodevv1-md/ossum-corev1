  article     Article?     @relation("ArticleNecesidadesCompra", fields: [articleId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  surgery     Surgery?     @relation("SurgeryNecesidadesCompra", fields: [companyId, surgeryId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  ordenCompra OrdenCompra? @relation("OrdenCompraNecesidades", fields: [companyId, ordenCompraId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  createdBy   User?        @relation("NecesidadCompraCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([companyId, id], map: "uq_necesidad_compra_company_id")
  @@unique([companyId, idempotencyKey], map: "uq_necesidad_compra_idempotency", where: raw("\"idempotency_key\" IS NOT NULL"))
  @@index([companyId, state], map: "ix_necesidad_compra_company_state")
  @@index([companyId, origin], map: "ix_necesidad_compra_company_origin")
  @@index([companyId, createdAt(sort: Desc)], map: "ix_necesidad_compra_company_created")
  @@map("necesidad_compra")
}

enum OrdenPagoState {
  Emitida
  Anulada
}

model OrdenPago {
  id            String         @id @default(cuid())
  visibleNumber Int?           @map("visible_number")
  companyId     String         @map("company_id")
  proveedorId   String         @map("proveedor_id")
  proveedorName String         @map("proveedor_name")
  total         Decimal        @default(0) @db.Decimal(14, 4)
  method        String?        @map("method")
  paymentDate   DateTime       @default(now()) @map("payment_date") @db.Timestamptz(6)
  state         OrdenPagoState @default(Emitida)
  observaciones String?        @db.Text
  createdById   String?        @map("created_by_id")
  updatedById   String?        @map("updated_by_id")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  company       Company               @relation("CompanyOrdenesPago", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  proveedorLink ContactCompanyLink    @relation("ContactCompanyOrdenPago", fields: [proveedorId, companyId], references: [contactId, companyId], onDelete: Restrict, onUpdate: Cascade)
  createdBy     User?                 @relation("OrdenPagoCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  updatedBy     User?                 @relation("OrdenPagoUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  imputaciones  OrdenPagoImputacion[] @relation("OrdenPagoImputaciones")

  @@unique([companyId, id], map: "uq_orden_pago_company_id")
  @@index([companyId, state], map: "ix_orden_pago_company_state")
  @@index([companyId, proveedorId], map: "ix_orden_pago_company_proveedor")
  @@index([companyId, paymentDate(sort: Desc)], map: "ix_orden_pago_company_date")
  @@map("orden_pago")
}

model OrdenPagoImputacion {
  id              String   @id @default(cuid())
  companyId       String   @map("company_id")
  ordenPagoId     String   @map("orden_pago_id")
  facturaCompraId String   @map("factura_compra_id")
  amount          Decimal  @db.Decimal(14, 4)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company       Company       @relation("CompanyOrdenPagoImputaciones", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  ordenPago     OrdenPago     @relation("OrdenPagoImputaciones", fields: [companyId, ordenPagoId], references: [companyId, id], onDelete: Cascade, onUpdate: Cascade)
  facturaCompra FacturaCompra @relation("FacturaCompraOrdenPagoImputaciones", fields: [companyId, facturaCompraId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([companyId, id], map: "uq_orden_pago_imputacion_company_id")
  @@unique([companyId, ordenPagoId, facturaCompraId], map: "uq_orden_pago_imputacion_unique")
  @@index([companyId, ordenPagoId], map: "ix_orden_pago_imputacion_op")
  @@index([companyId, facturaCompraId], map: "ix_orden_pago_imputacion_fc")
  @@map("orden_pago_imputacion")
}

// ─── Calendario Personal V1 ──────────────────────────────────────────

model PersonalCalendarEvent {
  id          String    @id @default(cuid())
  companyId   String    @map("company_id")
  userId      String    @map("user_id")
  title       String    @db.VarChar(200)
  description String?   @db.Text
  startDate   DateTime  @map("start_date") @db.Timestamptz(6)
  endDate     DateTime  @map("end_date") @db.Timestamptz(6)
  isCancelled Boolean   @default(false) @map("is_cancelled")
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation("CompanyPersonalCalendarEvents", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user    User    @relation("UserPersonalCalendarEvents", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([companyId, id], map: "uq_personal_calendar_event_company_id")
  @@index([companyId, userId, isCancelled], map: "ix_personal_event_company_user_cancelled")
  @@index([companyId, userId, startDate(sort: Asc)], map: "ix_personal_event_company_user_start")
  @@map("personal_calendar_event")
}
