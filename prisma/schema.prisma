// OSSUM COR — Schema inicial V1
// Prisma 7 — datasource configurado en prisma.config.ts
// Multiempresa desde inicio. Auditoría preparada.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Organización / Tenant ───────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  taxId     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companies Company[]
}

// ─── Empresa ─────────────────────────────────────────────────────────

model Company {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  taxId          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id])
  branches     Branch[]
  users        UserCompanyAccess[]
  contacts     ContactCompanyLink[]
  groups       ContactGroup[]
  surgeries    Surgery[]
  auditEvents  AuditEvent[]
}

// ─── Sucursal ────────────────────────────────────────────────────────

model Branch {
  id        String   @id @default(cuid())
  companyId String
  name      String
  address   String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company   @relation(fields: [companyId], references: [id])
  surgeries Surgery[]
}

// ─── Usuario ─────────────────────────────────────────────────────────

model User {
  id             String   @id @default(cuid())
  supabaseAuthId String?  @unique
  email          String   @unique
  firstName      String
  lastName       String
  phone          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  companyAccess UserCompanyAccess[]
  auditEvents   AuditEvent[]
}

// ─── Acceso Usuario → Empresa ────────────────────────────────────────

model UserCompanyAccess {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  role      String   @default("operator")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@unique([userId, companyId])
}

// ─── Contacto ────────────────────────────────────────────────────────

model Contact {
  id             String   @id @default(cuid())
  firstName      String?
  lastName       String?
  legalName      String?
  isCompany      Boolean  @default(false)
  email          String?
  phone          String?
  documentType   String?
  documentNumber String?
  contactType    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  companyLinks         ContactCompanyLink[]
  groupMemberships     ContactGroupMembership[]
  addresses            ContactAddress[]
  patientSurgeries     Surgery[]                @relation("PatientSurgeries")
  doctorSurgeries      Surgery[]                @relation("DoctorSurgeries")
  institutionSurgeries Surgery[]                @relation("InstitutionSurgeries")
}

// ─── Vínculo Contacto → Empresa ──────────────────────────────────────

model ContactCompanyLink {
  id        String   @id @default(cuid())
  contactId String
  companyId String
  role      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contact Contact @relation(fields: [contactId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@unique([contactId, companyId])
}

// ─── Grupo de Contactos ──────────────────────────────────────────────

model ContactGroup {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company                  @relation(fields: [companyId], references: [id])
  members ContactGroupMembership[]
}

// ─── Miembro de Grupo ────────────────────────────────────────────────

model ContactGroupMembership {
  id        String   @id @default(cuid())
  groupId   String
  contactId String
  createdAt DateTime @default(now())

  group   ContactGroup @relation(fields: [groupId], references: [id])
  contact Contact      @relation(fields: [contactId], references: [id])

  @@unique([groupId, contactId])
}

// ─── Dirección de Contacto ───────────────────────────────────────────

model ContactAddress {
  id          String   @id @default(cuid())
  contactId   String
  street      String?
  number      String?
  city        String?
  state       String?
  zipCode     String?
  country     String   @default("AR")
  isMain      Boolean  @default(false)
  addressType String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contact Contact @relation(fields: [contactId], references: [id])
}

// ─── Cirugía (mínima V1) ─────────────────────────────────────────────

model Surgery {
  id            String   @id @default(cuid())
  companyId     String
  branchId      String?
  patientId     String
  doctorId      String?
  institutionId String?
  surgeryDate   DateTime
  status        String   @default("pending")
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company     Company  @relation(fields: [companyId], references: [id])
  branch      Branch?  @relation(fields: [branchId], references: [id])
  patient     Contact  @relation("PatientSurgeries", fields: [patientId], references: [id])
  doctor      Contact? @relation("DoctorSurgeries", fields: [doctorId], references: [id])
  institution Contact? @relation("InstitutionSurgeries", fields: [institutionId], references: [id])
}

// ─── Auditoría ───────────────────────────────────────────────────────

model AuditEvent {
  id         String   @id @default(cuid())
  companyId  String
  userId     String
  entityType String
  entityId   String
  action     String
  detail     String?
  oldValue   Json?
  newValue   Json?
  module     String
  metadata   Json?
  createdAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([companyId, createdAt])
  @@index([userId, createdAt])
}
