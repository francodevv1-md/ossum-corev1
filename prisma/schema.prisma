  NONE
  LOT
  LOT_EXPIRY
  SERIAL
  SERIAL_EXPIRY
  LOT_SERIAL_EXPIRY
}

enum ArticleTraceabilityRequirement {
  NONE
  LOT
  SERIAL
  LOT_OR_SERIAL
  LOT_AND_SERIAL
}

model ArticleIdentifier {
  id                  String                @id @default(cuid())
  organizationId      String
  articleId           String
  type                ArticleIdentifierType
  value               String
  normalizedValue     String
  sourcePayload       String?
  scopeKey            String                @default("")
  manufacturerContext String?
  supplierId          String?
  companyId           String?
  isActive            Boolean               @default(true)
  deactivatedAt       DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  article      Article             @relation("ArticleIdentifiers", fields: [organizationId, articleId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  supplierLink ContactCompanyLink? @relation("ArticleIdentifierSupplierLink", fields: [supplierId, companyId], references: [contactId, companyId], onDelete: Restrict, onUpdate: Restrict)
  company      Company?            @relation("ArticleIdentifierCompany", fields: [organizationId, companyId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, type, normalizedValue, scopeKey], where: raw("\"isActive\" = true AND \"companyId\" IS NULL"))
  @@unique([organizationId, companyId, type, normalizedValue, scopeKey], where: raw("\"isActive\" = true AND \"companyId\" IS NOT NULL"))
  @@index([organizationId, companyId, normalizedValue, isActive])
  @@index([organizationId, companyId, type, normalizedValue, isActive])
}

