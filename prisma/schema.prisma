  eligibilityByArticle                 StockArticleEligibility        @relation("StockPositionEligibilityByArticle", fields: [companyId, articleId], references: [companyId, articleId], onDelete: Restrict, onUpdate: Cascade, map: "fk_sp_eligibility_article")
  policyVersion                        StockArticlePolicyVersion      @relation("StockPositionPolicyVersion", fields: [companyId, eligibilityId, policyVersionId], references: [companyId, eligibilityId, id], onDelete: Restrict, onUpdate: Cascade, map: "fk_sp_policy_version")
