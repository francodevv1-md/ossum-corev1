model DurableAttemptAuditEvent {
  eventId                 String   @id(map: "durable_attempt_audit_event_pkey") @map("event_id") @db.Char(64)
  schemaVersion           String   @map("schema_version") @db.VarChar(64)
  policyId                String   @map("policy_id") @db.VarChar(64)
  correlationId           String   @map("correlation_id") @db.Uuid
  eventOrdinal            Int      @map("event_ordinal")
  eventKind               String   @map("event_kind") @db.VarChar(32)
  bundleId                String   @map("bundle_id") @db.VarChar(16)
  contractIds             Json     @map("contract_ids")
  companyId               String   @map("company_id")
  bundleSemanticKeySha256 String   @map("bundle_semantic_key_sha256") @db.Char(64)
  completePayloadSha256   String   @map("complete_payload_sha256") @db.Char(64)
  policySetSha256         String   @map("policy_set_sha256") @db.Char(64)
  writerRegistrySha256    String   @map("writer_registry_sha256") @db.Char(64)
  scannerInputSha256      String   @map("scanner_input_sha256") @db.Char(64)
  attemptOrdinal          Int?     @map("attempt_ordinal")
  transactionId           String?  @map("transaction_id") @db.Uuid
  anchorSetSha256         String?  @map("anchor_set_sha256") @db.Char(64)
  sqlstate                String?  @db.VarChar(5)
  domainCommitState       String   @map("domain_commit_state") @db.VarChar(16)
  occurredAt              DateTime @map("occurred_at") @db.Timestamptz(3)
  predecessorEventSha256  String?  @map("predecessor_event_sha256") @db.Char(64)
  eventSha256             String   @map("event_sha256") @db.Char(64)
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company     Company                    @relation("CompanyDurableAttemptAuditEvents", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_daae_company")
  predecessor DurableAttemptAuditEvent?  @relation("DurableAttemptAuditEventChain", fields: [correlationId, predecessorEventSha256], references: [correlationId, eventSha256], onDelete: Restrict, onUpdate: Cascade, map: "fk_daae_predecessor")
  successors  DurableAttemptAuditEvent[] @relation("DurableAttemptAuditEventChain")

  @@unique([eventSha256], map: "uq_daae_event_sha256")
  @@unique([correlationId, eventOrdinal], map: "uq_daae_correlation_ordinal")
  @@unique([correlationId, eventSha256], map: "uq_daae_correlation_event_sha256")
  @@unique([correlationId, predecessorEventSha256], map: "uq_daae_correlation_predecessor")
  @@index([companyId, bundleSemanticKeySha256, occurredAt], map: "ix_daae_company_semantic_time")
  @@index([eventKind, occurredAt], map: "ix_daae_kind_time")
  @@index([occurredAt], map: "ix_daae_occurred_at")
  @@map("durable_attempt_audit_event")
}

model GoodsReceipt {
  id                String    @id @default(cuid())
  companyId         String
  createdById       String
  confirmedById     String?
  status            String    @default("DRAFT")
  supplierId        String?
  documentReference String?
  idempotencyKey    String?
  confirmedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company     Company            @relation("GoodsReceiptCompany", fields: [companyId], references: [id], onDelete: Restrict)
  createdBy   User               @relation("GoodsReceiptCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  confirmedBy User?              @relation("GoodsReceiptConfirmedBy", fields: [confirmedById], references: [id], onDelete: Restrict)
  lines       GoodsReceiptLine[]
  scanEvents  ScanEvent[]

  @@unique([companyId, id], map: "uq_goods_receipt_company_id")
  @@unique([companyId, idempotencyKey], map: "uq_goods_receipt_idempotency")
  @@index([companyId, status, createdAt])
}

model GoodsReceiptLine {
  id                     String    @id @default(cuid())
  companyId              String
  receiptId              String
  lineNumber             Int
  articleId              String?
  requestedQuantity      Decimal   @db.Decimal(24, 4)
  expectedQuantity       Decimal?  @db.Decimal(24, 4)
  receivedQuantity       Decimal   @default(0) @db.Decimal(24, 4)
  expectedCode           String?
  expectedDescription    String?
  lotCode                String?
  serialNumber           String?
  expirationDate         DateTime? @db.Date
  receivedLotCode        String?
  receivedSerialNumber   String?
  receivedExpirationDate DateTime? @db.Date
  rawScan                String?
  resolutionStatus       String    @default("PENDING")
  pendingReason          String?
  confirmedEvidenceId    String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  receipt GoodsReceipt             @relation(fields: [companyId, receiptId], references: [companyId, id], onDelete: Cascade)
  article StockArticleEligibility? @relation("GoodsReceiptLineEligibility", fields: [companyId, articleId], references: [companyId, articleId], onDelete: Restrict)
  scans   ScanEvent[]

  @@unique([companyId, id], map: "uq_goods_receipt_line_company_id")
  @@unique([receiptId, lineNumber], map: "uq_goods_receipt_line_number")
  @@unique([companyId, receiptId, id], map: "uq_goods_receipt_line_receipt_id")
  @@index([companyId, articleId, resolutionStatus])
}

model ScanEvent {
  id               String    @id @default(cuid())
  companyId        String
  receiptId        String
  lineId           String?
  articleId        String?
  rawValue         String
  normalizedValue  String?
  resolutionStatus String    @default("PENDING")
  candidates       Json?
  lotCode          String?
  serialNumber     String?
  expirationDate   DateTime? @db.Date
  captureHistory   Json?
  createdById      String
  createdAt        DateTime  @default(now())

  receipt   GoodsReceipt             @relation(fields: [companyId, receiptId], references: [companyId, id], onDelete: Cascade)
  line      GoodsReceiptLine?        @relation(fields: [companyId, receiptId, lineId], references: [companyId, receiptId, id], onDelete: Restrict)
  article   StockArticleEligibility? @relation("ScanEventEligibility", fields: [companyId, articleId], references: [companyId, articleId], onDelete: Restrict)
  createdBy User                     @relation("ScanEventCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([companyId, id], map: "uq_scan_event_company_id")
  @@index([companyId, receiptId, createdAt])
  @@index([companyId, receiptId, resolutionStatus])
  @@index([articleId])
}

