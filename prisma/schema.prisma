  sourceControlLine       CajasControlLine             @relation("CajasDispatchLineControl", fields: [companyId, sourceControlLineId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade, map: "fk_cdl_control_line")
  sourcePreparationLine   CajasPreparationLine         @relation("CajasDispatchLinePreparation", fields: [companyId, sourcePreparationLineId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade, map: "fk_cdl_prep_line")
  articleReference        CajasArticleReference        @relation("CajasDispatchLineArticle", fields: [companyId, articleReferenceId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade, map: "fk_cdl_article")
  stockScopeReference     CajasStockScopeReference?    @relation("CajasDispatchLineStockScope", fields: [companyId, stockScopeReferenceId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade, map: "fk_cdl_stock_scope")
  stockEffectReference    CajasStockRecordReference    @relation("CajasDispatchLineStockEffect", fields: [companyId, stockEffectReferenceId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade, map: "fk_cdl_stock_effect")
  differences             CajasDifference[]            @relation("CajasDifferenceDispatchOrigin")
  accounting              CajasDispatchLineAccounting? @relation("CajasDispatchLineAccounting")
  dispositions            CajasDisposition[]           @relation("CajasDispositionDispatchLine")
  returnLines             CajasReturnLine[]            @relation("CajasReturnLineDispatchLine")
  replacementPairs        CajasReplacementPair[]       @relation("CajasReplacementOriginalDispatch")
  consumptionLines        CajasConsumptionLine[]       @relation("CajasConsumptionLineDispatchLine")

  @@unique([companyId, id], map: "uq_cdl_company_id")
  @@unique([companyId, dispatchId, id], map: "uq_cdl_dispatch_id")
  @@unique([dispatchId, lineNumber], map: "uq_cdl_dispatch_line")
  @@unique([dispatchId, remitoItemId, sourceControlLineId], map: "uq_cdl_source_scope")
  @@unique([companyId, neutralizesDispatchLineId], map: "uq_cdl_neutralizes")
  @@index([companyId, remitoId, remitoItemId], map: "ix_cdl_remito_item")
  @@index([companyId, sourceControlLineId], map: "ix_cdl_company_control")
  @@index([sourcePreparationLineId], map: "ix_cdl_prep_line")
  @@index([stockScopeReferenceId], map: "ix_cdl_stock_scope")
  @@index([stockEffectReferenceId], map: "ix_cdl_stock_effect")
  @@map("cajas_dispatch_line")
}

model CajasDispatchAccounting {
