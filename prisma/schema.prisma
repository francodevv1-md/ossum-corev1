  companyId                   String   @map("company_id")
  assignmentId                String   @map("assignment_id")
  priorPreparationVersion     Int      @map("prior_preparation_version")
  resultingPreparationVersion Int      @map("resulting_preparation_version")
  acceptedAt                  DateTime @map("accepted_at") @db.Timestamptz(6)
  acceptedById                String   @map("accepted_by_id")
  cause                       String?  @map("cause") @db.Text
  commandAcceptanceId         String   @map("command_acceptance_id")
  createdAt                   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company              Company                      @relation("CajasCompanyCompositionChanges", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_cchg_company")
  assignment           CajasAssignment              @relation("CajasAssignmentChanges", fields: [companyId, assignmentId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade, map: "fk_cchg_assignment")
  acceptedBy           User                         @relation("CajasCompositionChangeAcceptedBy", fields: [acceptedById], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_cchg_accepted_by")
  commandAcceptance    CajasCommandAcceptance       @relation("CajasCommandCompositionChange", fields: [companyId, commandAcceptanceId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade, map: "fk_cchg_command")
  latestForPreparation CajasPreparation?            @relation("CajasPreparationLastChange")
  lines                CajasCompositionChangeLine[] @relation("CajasCompositionChangeLines")

  @@unique([companyId, id], map: "uq_cchg_company_id")
  @@unique([assignmentId, resultingPreparationVersion], map: "uq_cchg_assignment_version")
  @@unique([companyId, commandAcceptanceId], map: "uq_cchg_command")
  @@index([companyId, assignmentId, acceptedAt], map: "ix_cchg_assignment_time")
  @@map("cajas_composition_change")
}

model CajasCompositionChangeLine {
  id                             String          @id(map: "cajas_composition_change_line_pkey") @default(cuid()) @map("id")
  companyId                      String          @map("company_id")
  changeId                       String          @map("change_id")
  lineNumber                     Int             @map("line_number")
  kind                           CajasChangeKind @map("kind")
  priorPreparationLineId         String?         @map("prior_preparation_line_id")
  resultingPreparationLineId     String?         @map("resulting_preparation_line_id")
  priorArticleReferenceId        String?         @map("prior_article_reference_id")
  resultingArticleReferenceId    String?         @map("resulting_article_reference_id")
  priorStockScopeReferenceId     String?         @map("prior_stock_scope_reference_id")
  resultingStockScopeReferenceId String?         @map("resulting_stock_scope_reference_id")
  priorQuantity                  Decimal?        @map("prior_quantity") @db.Decimal(18, 4)
  resultingQuantity              Decimal?        @map("resulting_quantity") @db.Decimal(18, 4)
  unit                           String          @map("unit")
  priorTraceabilitySnapshot      Json?           @map("prior_traceability_snapshot")
  resultingTraceabilitySnapshot  Json?           @map("resulting_traceability_snapshot")
  createdAt                      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  company                      Company                   @relation("CajasCompanyCompositionChangeLines", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_cchl_company")
  change                       CajasCompositionChange    @relation("CajasCompositionChangeLines", fields: [companyId, changeId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade, map: "fk_cchl_change")
  priorPreparationLine         CajasPreparationLine?     @relation("CajasChangePriorPreparationLine", fields: [companyId, priorPreparationLineId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade, map: "fk_cchl_prior_line")
  resultingPreparationLine     CajasPreparationLine?     @relation("CajasChangeResultPreparationLine", fields: [companyId, resultingPreparationLineId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade, map: "fk_cchl_result_line")
  priorArticleReference        CajasArticleReference?    @relation("CajasChangePriorArticle", fields: [companyId, priorArticleReferenceId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade, map: "fk_cchl_prior_article")
  resultingArticleReference    CajasArticleReference?    @relation("CajasChangeResultArticle", fields: [companyId, resultingArticleReferenceId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade, map: "fk_cchl_result_article")
  priorStockScopeReference     CajasStockScopeReference? @relation("CajasChangePriorStockScope", fields: [companyId, priorStockScopeReferenceId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade, map: "fk_cchl_prior_scope")
  resultingStockScopeReference CajasStockScopeReference? @relation("CajasChangeResultStockScope", fields: [companyId, resultingStockScopeReferenceId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade, map: "fk_cchl_result_scope")

  @@unique([companyId, id], map: "uq_cchl_company_id")
  @@unique([changeId, lineNumber], map: "uq_cchl_change_line")
  @@index([companyId, changeId], map: "ix_cchl_company_change")
  @@index([priorPreparationLineId], map: "ix_cchl_prior_line")
  @@index([resultingPreparationLineId], map: "ix_cchl_result_line")
  @@map("cajas_composition_change_line")
}

model CajasDifference {
  id             String   @id(map: "cajas_difference_pkey") @default(cuid()) @map("id")
  companyId      String   @map("company_id")
  assignmentId   String   @map("assignment_id")
  controlLineId  String?  @map("control_line_id")
  dispatchLineId String?  @map("dispatch_line_id")
  returnLineId   String?  @map("return_line_id")
  kind           String   @map("kind")
  observedFacts  String   @map("observed_facts") @db.Text
  openedAt       DateTime @map("opened_at") @db.Timestamptz(6)
  openedById     String   @map("opened_by_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company      Company                     @relation("CajasCompanyDifferences", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_cd_company")
  assignment   CajasAssignment             @relation("CajasAssignmentDifferences", fields: [companyId, assignmentId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade, map: "fk_cd_assignment")
  controlLine  CajasControlLine?           @relation("CajasDifferenceControlOrigin", fields: [companyId, controlLineId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade, map: "fk_cd_control_line")
  dispatchLine CajasDispatchLine?          @relation("CajasDifferenceDispatchOrigin", fields: [companyId, dispatchLineId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade, map: "fk_cd_dispatch_line")
  returnLine   CajasReturnLine?            @relation("CajasDifferenceReturnOrigin", fields: [companyId, returnLineId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade, map: "fk_cd_return_line")
  openedBy     User                        @relation("CajasDifferenceOpenedBy", fields: [openedById], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_cd_opened_by")
  resolutions  CajasDifferenceResolution[] @relation("CajasDifferenceResolutions")

  @@unique([companyId, id], map: "uq_cd_company_id")
  @@index([companyId, assignmentId, openedAt], map: "ix_cd_assignment_opened")
  @@index([controlLineId], map: "ix_cd_control_line")
  @@index([dispatchLineId], map: "ix_cd_dispatch_line")
  @@index([returnLineId], map: "ix_cd_return_line")
