// OSSUM COR — Schema inicial V1
// Prisma 7 — datasource configurado en prisma.config.ts
// Multiempresa desde inicio. Auditoría preparada.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ─── Organización / Tenant ───────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  taxId     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companies             Company[]
  articles              Article[]               @relation("OrganizationArticles")
  productCategories     ProductCategory[]
  clinicalFamilies      ClinicalFamily[]
  brands                Brand[]
  manufacturers         Manufacturer[]
  productLines          ProductLine[]
  catalogAliases        CatalogAlias[]
  xadminImportRuns      XadminImportRun[]
  xadminArticleRows     XadminArticleStageRow[]
  xadminArticleMappings XadminArticleMapping[]
}

// ─── Empresa ─────────────────────────────────────────────────────────

model Company {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  taxId          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization                     Organization                             @relation(fields: [organizationId], references: [id])
  branches                         Branch[]
  users                            UserCompanyAccess[]
  contacts                         ContactCompanyLink[]
  contactAddresses                 ContactAddress[]
  articleIdentifiers               ArticleIdentifier[]                      @relation("ArticleIdentifierCompany")
  articleSupplierMappings          ArticleSupplierMapping[]                 @relation("ArticleSupplierMappingCompany")
  groups                           ContactGroup[]
  surgeries                        Surgery[]
  remitos                          Remito[]
  remitoScanLocators               RemitoScanLocator[]                      @relation("CompanyRemitoScanLocators")
  remitoVerificationPublications   RemitoVerificationPublication[]          @relation("CompanyRemitoVerificationPublications")
  remitoVerificationAccesses       RemitoVerificationAccess[]               @relation("CompanyRemitoVerificationAccesses")
  remitoVerificationDailyMetrics   RemitoVerificationDailyMetric[]          @relation("CompanyRemitoVerificationDailyMetrics")
  consumos                         Consumo[]
  devoluciones                     Devolucion[]
  presupuestos                     Presupuesto[]
  presupuestoFamilies              PresupuestoFamily[]
  invoices                         Invoice[]
  payments                         Payment[]
  digitalReceipts                  DigitalReceipt[]
  auditEvents                      AuditEvent[]
  seguimientoEntries               SeguimientoEntry[]
  internalNotifications            InternalNotification[]
  operationalAssignees             CompanyOperationalAssignee[]             @relation("AvailabilityCompanyOperationalAssignees")
  availabilityRequests             AvailabilityRequest[]                    @relation("AvailabilityCompanyRequests")
  availabilityRecipientAssignments AvailabilityRequestRecipientAssignment[] @relation("AvailabilityCompanyRecipientAssignments")
  availabilityCommands             AvailabilityCommand[]                    @relation("AvailabilityCompanyCommands")
  availabilityCapabilityGrants     AvailabilityCapabilityGrant[]            @relation("AvailabilityCapabilityCompany")
  viewPreferences                  UserModuleViewPreference[]
  surgeryDocumentChecklists        SurgeryDocumentChecklist[]               @relation("CompanyDocumentChecklists")
  surgeryDocumentItems             SurgeryDocumentItem[]                    @relation("CompanyDocumentItems")
  cajasBoxFormulas                 CajasBoxFormula[]                        @relation("CajasCompanyBoxFormulas")
  cajasAssignments                 CajasAssignment[]                        @relation("CajasCompanyAssignments")
  cajasUnitLogEntries              CajasUnitLogEntry[]                      @relation("CajasUnitLogCompany")
  cajasMaintenanceCases            CajasMaintenanceCase[]                   @relation("CajasMaintenanceCompany")
  cajasReservationCorrelations     CajasReservationCorrelation[]            @relation("CajasCompanyReservationCorrelations")
  stockArticleEligibilities        StockArticleEligibility[]                @relation("CompanyStockArticleEligibilities")
  stockDeposits                    StockDeposit[]                           @relation("CompanyStockDeposits")
  stockContexts                    StockContext[]                           @relation("CompanyStockContexts")
  stockEvidences                   StockEvidence[]                          @relation("StockEvidenceCompany")
  operationalCommandAcceptances    OperationalCommandAcceptance[]           @relation("OperationalCommandAcceptanceCompany")
  operationalCommandAttempts       OperationalCommandAttempt[]              @relation("OperationalCommandAttemptCompany")
  compatibilityReferences          StockCompatibilityReference[]            @relation("StockCompatibilityReferenceCompany")
  projectionReconciliations        ProjectionReconciliation[]               @relation("ProjectionReconciliationCompany")
  durableAttemptAuditEvents        DurableAttemptAuditEvent[]               @relation("CompanyDurableAttemptAuditEvents")
  goodsReceipts                    GoodsReceipt[]                           @relation("GoodsReceiptCompany")
  surgeryPreparations              SurgeryPreparation[]                     @relation("SurgeryPreparationCompany")
  vehicles                         Vehicle[]

  @@unique([organizationId, id], map: "uq_company_organization_id")
}

model Vehicle {
  id               String   @id @default(cuid())
  companyId        String
  name             String
  provider         String   @default("rastreo_satelital")
  trackingDeviceId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company        Company                @relation(fields: [companyId], references: [id], onDelete: Restrict)
  latestPosition VehicleLatestPosition?

  @@unique([companyId, id], map: "uq_vehicle_company_id")
  @@unique([companyId, provider, trackingDeviceId], map: "uq_vehicle_company_provider_device")
  @@index([companyId, provider], map: "ix_vehicle_company_provider")
}

model VehicleLatestPosition {
  vehicleId  String   @id
  companyId  String
  latitude   Decimal  @db.Decimal(10, 7)
  longitude  Decimal  @db.Decimal(10, 7)
  recordedAt DateTime
  receivedAt DateTime @default(now())

  vehicle Vehicle @relation(fields: [companyId, vehicleId], references: [companyId, id], onDelete: Cascade)

  @@unique([companyId, vehicleId], map: "uq_vehicle_latest_position_company_vehicle")
  @@index([companyId, recordedAt], map: "ix_vehicle_latest_position_company_recorded")
}

// ─── Sucursal ────────────────────────────────────────────────────────

model Branch {
  id        String   @id @default(cuid())
  companyId String
  name      String
  address   String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company       Company       @relation(fields: [companyId], references: [id])
  surgeries     Surgery[]
  remitos       Remito[]      @relation("RemitoBranch")
  issuedRemitos Remito[]      @relation("RemitoIssuedBranch")
  presupuestos  Presupuesto[]

  @@unique([companyId, id], map: "uq_branch_company_id")
}

// ─── Usuario ─────────────────────────────────────────────────────────

model User {
  id             String   @id @default(cuid())
  supabaseAuthId String?  @unique
  email          String   @unique
  firstName      String
  lastName       String
  phone          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  companyAccess                                    UserCompanyAccess[]
  auditEvents                                      AuditEvent[]
  seguimientoEntries                               SeguimientoEntry[]
  receivedInternalNotifications                    InternalNotification[]                    @relation("InternalNotificationRecipient")
  sentInternalNotifications                        InternalNotification[]                    @relation("InternalNotificationActor")
  createdSurgeries                                 Surgery[]                                 @relation("SurgeryCreatedBy")
  createdOperationalAssignees                      CompanyOperationalAssignee[]              @relation("CompanyOperationalAssigneeCreatedBy")
  updatedOperationalAssignees                      CompanyOperationalAssignee[]              @relation("CompanyOperationalAssigneeUpdatedBy")
  requestedAvailabilityRequests                    AvailabilityRequest[]                     @relation("AvailabilityRequester")
  completedAvailabilityRequests                    AvailabilityRequest[]                     @relation("AvailabilityCompleter")
  creatorSnapshotAvailabilityRequests              AvailabilityRequest[]                     @relation("AvailabilityCreatorUserSnapshot")
  pivotSnapshotAvailabilityRequests                AvailabilityRequest[]                     @relation("AvailabilityPivotUserSnapshot")
  assignedAvailabilityRecipients                   AvailabilityRequestRecipientAssignment[]  @relation("AvailabilityAssignmentAssignedBy")
  revokedAvailabilityRecipients                    AvailabilityRequestRecipientAssignment[]  @relation("AvailabilityAssignmentRevokedBy")
  availabilityCommands                             AvailabilityCommand[]                     @relation("AvailabilityCommandActor")
  grantedAvailabilityCapabilities                  AvailabilityCapabilityGrant[]             @relation("AvailabilityCapabilityGrantedBy")
  revokedAvailabilityCapabilities                  AvailabilityCapabilityGrant[]             @relation("AvailabilityCapabilityRevokedBy")
  viewPreferences                                  UserModuleViewPreference[]
  createdRemitos                                   Remito[]                                  @relation("RemitoCreatedBy")
  updatedRemitos                                   Remito[]                                  @relation("RemitoUpdatedBy")
  createdConsumos                                  Consumo[]                                 @relation("ConsumoCreatedBy")
  updatedConsumos                                  Consumo[]                                 @relation("ConsumoUpdatedBy")
  createdDevoluciones                              Devolucion[]                              @relation("DevolucionCreatedBy")
  updatedDevoluciones                              Devolucion[]                              @relation("DevolucionUpdatedBy")
  createdPresupuestos                              Presupuesto[]                             @relation("PresupuestoCreatedBy")
  updatedPresupuestos                              Presupuesto[]                             @relation("PresupuestoUpdatedBy")
  createdInvoices                                  Invoice[]                                 @relation("InvoiceCreatedBy")
  updatedInvoices                                  Invoice[]                                 @relation("InvoiceUpdatedBy")
  createdPayments                                  Payment[]                                 @relation("PaymentCreatedBy")
  updatedPayments                                  Payment[]                                 @relation("PaymentUpdatedBy")
  acceptedCajasFormulaVersions                     CajasFormulaVersion[]                     @relation("CajasFormulaVersionAcceptedBy")
  startedCajasAssignments                          CajasAssignment[]                         @relation("CajasAssignmentStartedBy")
  endedCajasAssignments                            CajasAssignment[]                         @relation("CajasAssignmentEndedBy")
  acceptedCajasControls                            CajasControl[]                            @relation("CajasControlAcceptedBy")
  acceptedCajasCompositionChanges                  CajasCompositionChange[]                  @relation("CajasCompositionChangeAcceptedBy")
  openedCajasDifferences                           CajasDifference[]                         @relation("CajasDifferenceOpenedBy")
  acceptedCajasDifferenceResolutions               CajasDifferenceResolution[]               @relation("CajasDifferenceResolutionAcceptedBy")
  acceptedCajasDispatches                          CajasDispatch[]                           @relation("CajasDispatchAcceptedBy")
  createdCajasUnitLogEntries                       CajasUnitLogEntry[]                       @relation("CajasUnitLogActor")
  openedCajasMaintenanceCases                      CajasMaintenanceCase[]                    @relation("CajasMaintenanceOpenedBy")
  acceptedCajasMaintenanceTransitions              CajasMaintenanceTransition[]              @relation("CajasMaintenanceTransitionActor")
  acceptedCajasReturnConfirmations                 CajasReturnConfirmation[]                 @relation("CajasReturnConfirmationAcceptedBy")
  acceptedCajasConsumptionConfirmations            CajasConsumptionConfirmation[]            @relation("CajasConsumptionConfirmationAcceptedBy")
  acceptedStockArticlePolicyVersions               StockArticlePolicyVersion[]               @relation("StockPolicyAcceptedBy")
  observedStockLotObservations                     StockLotObservation[]                     @relation("StockLotObservationObservedBy")
  acceptedStockLotReviews                          StockLotReview[]                          @relation("StockLotReviewAcceptedBy")
  acceptedStockLots                                StockLot[]                                @relation("StockLotAcceptedBy")
  acceptedStockIdentifiedUnitConfigurationVersions StockIdentifiedUnitConfigurationVersion[] @relation("StockIdentifiedUnitConfigurationAcceptedBy")
  acceptedStockEvidences                           StockEvidence[]                           @relation("StockEvidenceAcceptedBy")
  acceptedStockReservationEvidences                StockReservationEvidence[]                @relation("StockReservationEvidenceAcceptedBy")
  acceptedOperationalCommands                      OperationalCommandAcceptance[]            @relation("OperationalCommandAcceptanceAcceptedBy")
  operationalCommandAttempts                       OperationalCommandAttempt[]               @relation("OperationalCommandAttemptActor")
  acceptedStockCompatibilityReferences             StockCompatibilityReference[]             @relation("StockCompatibilityReferenceAcceptedBy")
  comparedProjectionReconciliations                ProjectionReconciliation[]                @relation("ProjectionReconciliationComparedBy")
  createdScanEvents                                ScanEvent[]                               @relation("ScanEventCreatedBy")
  createdGoodsReceipts                             GoodsReceipt[]                            @relation("GoodsReceiptCreatedBy")
  confirmedGoodsReceipts                           GoodsReceipt[]                            @relation("GoodsReceiptConfirmedBy")
  createdSurgeryPreparations                       SurgeryPreparation[]                      @relation("SurgeryPreparationCreatedBy")
  decidedXadminArticleMappings                     XadminArticleMapping[]                    @relation("XadminArticleMappingDecidedBy")
}

// ─── Preferencias de Vista por Módulo ───────────────────────────────

model UserModuleViewPreference {
  id          String   @id @default(cuid())
  companyId   String
  userId      String
  moduleKey   String
  preferences Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([companyId, userId, moduleKey])
  @@index([companyId, moduleKey])
  @@index([userId, moduleKey])
}

// ─── Acceso Usuario → Empresa ────────────────────────────────────────

model UserCompanyAccess {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  role      String   @default("operator")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                         User                                     @relation(fields: [userId], references: [id])
  company                      Company                                  @relation(fields: [companyId], references: [id])
  operationalAssignees         CompanyOperationalAssignee[]             @relation("CompanyOperationalAssigneeUserAccess")
  availabilityRecipientReasons AvailabilityRequestRecipientAssignment[] @relation("AvailabilityAssignmentUserAccess")
  availabilityCapabilityGrants AvailabilityCapabilityGrant[]            @relation("AvailabilityCapabilityUserAccess")
  createdDocumentChecklists    SurgeryDocumentChecklist[]               @relation("SurgeryDocumentChecklistCreatedByAccess")
  updatedDocumentChecklists    SurgeryDocumentChecklist[]               @relation("SurgeryDocumentChecklistUpdatedByAccess")
  createdDocumentItems         SurgeryDocumentItem[]                    @relation("SurgeryDocumentItemCreatedByAccess")
  updatedDocumentItems         SurgeryDocumentItem[]                    @relation("SurgeryDocumentItemUpdatedByAccess")

  @@unique([userId, companyId])
}

// ─── Contacto ────────────────────────────────────────────────────────

model Contact {
  id             String   @id @default(cuid())
  firstName      String?
  lastName       String?
  legalName      String?
  tradeName      String?
  notes          String?  @db.Text
  isCompany      Boolean  @default(false)
  email          String?
  phone          String?
  documentType   String?
  documentNumber String?
  contactType    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  companyLinks         ContactCompanyLink[]
  groupMemberships     ContactGroupMembership[]
  addresses            ContactAddress[]
  patientSurgeries     Surgery[]                  @relation("PatientSurgeries")
  doctorSurgeries      Surgery[]                  @relation("DoctorSurgeries")
  institutionSurgeries Surgery[]                  @relation("InstitutionSurgeries")
  payerSurgeries       Surgery[]                  @relation("PayerSurgeries")
  surgeryAssignments   SurgeryContactAssignment[]
}

// ─── Vínculo Contacto → Empresa ──────────────────────────────────────

model ContactCompanyLink {
  id               String   @id @default(cuid())
  contactId        String
  companyId        String
  code             String   @default("")
  role             String?
  roles            String[] @default([])
  isPayer          Boolean?
  vatCondition     String?
  paymentTerms     String?
  defaultPriceList String?
  usualDiscount    Decimal? @db.Decimal(9, 4)
  doctorLicense    String?
  specialty        String?
  deliveryNotes    String?  @db.Text
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  contact            Contact                  @relation(fields: [contactId], references: [id])
  company            Company                  @relation(fields: [companyId], references: [id])
  addresses          ContactAddress[]         @relation("ContactAddressCompanyLink")
  articleIdentifiers ArticleIdentifier[]      @relation("ArticleIdentifierSupplierLink")
  articleMappings    ArticleSupplierMapping[] @relation("ArticleSupplierMappingSupplierLink")
  clientPresupuestos Presupuesto[]            @relation("PresupuestoClientCompany")
  payerPresupuestos  Presupuesto[]            @relation("PresupuestoPayerCompany")

  @@unique([contactId, companyId])
  @@unique([companyId, code], map: "uq_contact_company_code")
  @@index([companyId, isActive, createdAt], map: "ix_contact_company_active_created")
}

// ─── Grupo de Contactos ──────────────────────────────────────────────

model ContactGroup {
  id          String   @id @default(cuid())
  companyId   String
  slug        String
  role        String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company                  @relation(fields: [companyId], references: [id])
  members ContactGroupMembership[]

  @@unique([companyId, slug], map: "uq_contact_group_company_slug")
}

// ─── Miembro de Grupo ────────────────────────────────────────────────

model ContactGroupMembership {
  id        String   @id @default(cuid())
  groupId   String
  contactId String
  createdAt DateTime @default(now())

  group   ContactGroup @relation(fields: [groupId], references: [id])
  contact Contact      @relation(fields: [contactId], references: [id])

  @@unique([groupId, contactId])
}

// ─── Dirección de Contacto ───────────────────────────────────────────

enum GeographicEntityType {
  PROVINCE
  DEPARTMENT
  MUNICIPALITY
  LOCALITY
  ADDRESS
}

enum GeographicCoordinateType {
  CENTROID
  ADDRESS
  GPS
  SURVEY
  MANUAL
  UNKNOWN
}

enum GeographicCrs {
  EPSG_4326 @map("EPSG:4326")
}

enum GeographicValidationStatus {
  VERIFIED        @map("verified")
  CANDIDATE       @map("candidate")
  CONFLICT        @map("conflict")
  MISSING         @map("missing")
  MANUAL_VERIFIED @map("manual_verified")
  DEPRECATED      @map("deprecated")
}

model ContactAddress {
  id                   String                      @id @default(cuid())
  contactId            String
  companyId            String
  street               String?
  number               String?
  city                 String?
  state                String?
  zipCode              String?
  country              String                      @default("AR")
  isMain               Boolean                     @default(false)
  addressType          String?
  georefId             String?
  entityType           GeographicEntityType?
  provinceGeorefId     String?
  provinceName         String?
  departmentGeorefId   String?
  departmentName       String?
  municipalityGeorefId String?
  municipalityName     String?
  latitude             Decimal?                    @db.Decimal(10, 7)
  longitude            Decimal?                    @db.Decimal(10, 7)
  coordinateType       GeographicCoordinateType?
  crs                  GeographicCrs?
  source               String?
  sourceVersion        String?
  sourceRetrievedAt    DateTime?
  validationStatus     GeographicValidationStatus?
  validationNotes      String?                     @db.Text
  geometry             Json?
  geometrySource       String?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt

  contact            Contact            @relation(fields: [contactId], references: [id])
  company            Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  contactCompanyLink ContactCompanyLink @relation("ContactAddressCompanyLink", fields: [contactId, companyId], references: [contactId, companyId], onDelete: Restrict)

  @@unique([companyId, contactId], map: "uq_contact_address_one_main", where: raw("\"isMain\" = true"))
  @@index([companyId, contactId, isMain], map: "ix_contact_address_main")
  @@index([georefId], map: "ix_contact_address_georef_id")
  @@index([validationStatus], map: "ix_contact_address_geo_validation")
}

// ─── Cirugía (Fase 1 — core expandido) ─────────────────────────────

model Surgery {
  id                       String    @id @default(cuid())
  companyId                String
  branchId                 String?
  visibleNumber            String?
  patientId                String
  doctorId                 String?
  institutionId            String?
  payerContactId           String?
  classification           String?
  description              String?
  priority                 String?
  cxStatus                 String    @default("pending")
  prepStatus               String?
  probableDate             DateTime?
  scheduledDate            DateTime?
  surgeryDate              DateTime?
  performedDate            DateTime?
  cancelledDate            DateTime?
  source                   String?
  notes                    String?
  archivedAt               DateTime?
  archivedById             String?
  archiveReason            String?
  archivePolicySnapshot    Json?
  createdById              String?
  materialAvailabilityDate DateTime? @db.Date
  materialShippingDate     DateTime? @db.Date
  materialTransport        String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  company     Company  @relation(fields: [companyId], references: [id])
  branch      Branch?  @relation(fields: [branchId], references: [id])
  patient     Contact  @relation("PatientSurgeries", fields: [patientId], references: [id])
  doctor      Contact? @relation("DoctorSurgeries", fields: [doctorId], references: [id])
  institution Contact? @relation("InstitutionSurgeries", fields: [institutionId], references: [id])
  payer       Contact? @relation("PayerSurgeries", fields: [payerContactId], references: [id])
  createdBy   User?    @relation("SurgeryCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_surgery_created_by")

  contactAssignments    SurgeryContactAssignment[]
  digitalReceipts       DigitalReceipt[]
  internalNotifications InternalNotification[]
  availabilityRequests  AvailabilityRequest[]      @relation("AvailabilityRequestSurgery")
  availabilityCommands  AvailabilityCommand[]      @relation("AvailabilityCommandSurgery")
  seguimientoEntries    SeguimientoEntry[]
  remitos               Remito[]
  consumos              Consumo[]
  devoluciones          Devolucion[]
  presupuestos          Presupuesto[]
  presupuestoFamily     PresupuestoFamily?
  invoices              Invoice[]
  payments              Payment[]
  documentChecklist     SurgeryDocumentChecklist?  @relation("SurgeryDocumentChecklistSurgery")

  cajasAssignments  CajasAssignment[]    @relation("CajasSurgeryAssignments")
  stockPreparations SurgeryPreparation[] @relation("SurgeryPreparationSurgery")

  @@unique([companyId, id], map: "uq_surgery_company_id")
  @@unique([companyId, visibleNumber], map: "Surgery_companyId_visibleNumber_key")
  @@index([companyId, archivedAt])
  @@index([companyId, materialAvailabilityDate], map: "ix_surgery_company_material_availability")
  @@index([companyId, createdById], map: "ix_surgery_company_created_by")
}

model SurgeryDocumentChecklist {
  id              String   @id @default(cuid())
  companyId       String
  surgeryId       String
  templateVersion String   @default("documentation-v0.1")
  createdById     String
  updatedById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company         Company               @relation("CompanyDocumentChecklists", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_sdc_company")
  surgery         Surgery               @relation("SurgeryDocumentChecklistSurgery", fields: [companyId, surgeryId], references: [companyId, id], onDelete: Cascade, onUpdate: Cascade, map: "fk_sdc_surgery_tenant")
  createdByAccess UserCompanyAccess     @relation("SurgeryDocumentChecklistCreatedByAccess", fields: [createdById, companyId], references: [userId, companyId], onDelete: Restrict, onUpdate: Cascade, map: "fk_sdc_created_by_access")
  updatedByAccess UserCompanyAccess     @relation("SurgeryDocumentChecklistUpdatedByAccess", fields: [updatedById, companyId], references: [userId, companyId], onDelete: Restrict, onUpdate: Cascade, map: "fk_sdc_updated_by_access")
  items           SurgeryDocumentItem[] @relation("SurgeryDocumentChecklistItems")

  @@unique([companyId, surgeryId], map: "uq_sdc_company_surgery")
  @@unique([companyId, id], map: "uq_sdc_company_id")
  @@index([companyId, updatedAt], map: "ix_sdc_company_updated_at")
}

model SurgeryDocumentItem {
  id          String   @id @default(cuid())
  companyId   String
  checklistId String
  type        String
  label       String
  required    Boolean
  sortOrder   Int
  state       String   @default("pending")
  observation String?  @db.Text
  createdById String
  updatedById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company         Company                  @relation("CompanyDocumentItems", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_sdi_company")
  checklist       SurgeryDocumentChecklist @relation("SurgeryDocumentChecklistItems", fields: [companyId, checklistId], references: [companyId, id], onDelete: Cascade, onUpdate: Cascade, map: "fk_sdi_checklist_tenant")
  createdByAccess UserCompanyAccess        @relation("SurgeryDocumentItemCreatedByAccess", fields: [createdById, companyId], references: [userId, companyId], onDelete: Restrict, onUpdate: Cascade, map: "fk_sdi_created_by_access")
  updatedByAccess UserCompanyAccess        @relation("SurgeryDocumentItemUpdatedByAccess", fields: [updatedById, companyId], references: [userId, companyId], onDelete: Restrict, onUpdate: Cascade, map: "fk_sdi_updated_by_access")

  @@unique([checklistId, type], map: "uq_sdi_checklist_type")
  @@unique([companyId, id], map: "uq_sdi_company_id")
  @@index([companyId, checklistId, sortOrder], map: "ix_sdi_company_checklist_order")
}

// ─── Presupuesto versionable (Fase 1C) ─────────────────────────────────────
// Catálogos controlados en src/lib/validators/presupuesto.ts (NO enums Prisma).
// state ∈ Borrador | Emitido | Aprobado | Rechazado | Vencido | Reemplazado | Anulado
// Un presupuesto puede existir independiente o vinculado a cirugía.

model PresupuestoFamily {
  id        String   @id @default(cuid())
  companyId String
  surgeryId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  surgery      Surgery?      @relation(fields: [companyId, surgeryId], references: [companyId, id], onDelete: Restrict)
  presupuestos Presupuesto[]

  @@unique([companyId, id], map: "uq_presupuesto_family_company_id")
  @@unique([companyId, id, surgeryId], map: "uq_presupuesto_family_surgery_lineage")
  @@unique([companyId, surgeryId], map: "uq_presupuesto_family_surgery")
  @@index([companyId], map: "ix_presupuesto_family_company")
  @@map("presupuesto_family")
}

model Presupuesto {
  id                  String             @id @default(cuid())
  visibleNumber       Int?
  companyId           String
  company             Company            @relation(fields: [companyId], references: [id])
  familyId            String
  family              PresupuestoFamily  @relation(fields: [companyId, familyId], references: [companyId, id], onDelete: Restrict)
  surgeryId           String?
  surgery             Surgery?           @relation(fields: [companyId, surgeryId], references: [companyId, id], onDelete: Restrict)
  branchId            String
  branch              Branch             @relation(fields: [companyId, branchId], references: [companyId, id], onDelete: Restrict)
  clientContactId     String
  clientCompanyLink   ContactCompanyLink @relation("PresupuestoClientCompany", fields: [clientContactId, companyId], references: [contactId, companyId], onDelete: Restrict)
  payerContactId      String
  payerCompanyLink    ContactCompanyLink @relation("PresupuestoPayerCompany", fields: [payerContactId, companyId], references: [contactId, companyId], onDelete: Restrict)
  parentPresupuestoId String?
  parentPresupuesto   Presupuesto?       @relation("PresupuestoVersions", fields: [familyId, parentPresupuestoId], references: [familyId, id], onDelete: Restrict)
  versions            Presupuesto[]      @relation("PresupuestoVersions")
  sourcePresupuestoId String?
  sourcePresupuesto   Presupuesto?       @relation("PresupuestoSource", fields: [familyId, sourcePresupuestoId], references: [familyId, id], onDelete: Restrict)
  derivedPresupuestos Presupuesto[]      @relation("PresupuestoSource")
  versionNumber       Int                @default(1)
  slot                String             @default("DRAFT")
  revision            Int                @default(1)
  state               String             @default("Borrador")
  title               String?
  currency            String             @default("ARS")
  documentDate        DateTime           @db.Date
  paymentTerms        String
  priceListCode       String
  legend              String             @db.Text
  notes               String?            @db.Text
  generalDiscountRate Decimal            @default(0) @db.Decimal(9, 4)
  commercialSnapshot  Json
  subtotal            Decimal            @default(0) @db.Decimal(18, 4)
  discountTotal       Decimal            @default(0) @db.Decimal(18, 4)
  taxTotal            Decimal            @default(0) @db.Decimal(18, 4)
  total               Decimal            @default(0) @db.Decimal(18, 4)
  validUntil          DateTime?
  issuedAt            DateTime?
  approvedAt          DateTime?
  rejectedAt          DateTime?
  createdById         String?
  createdBy           User?              @relation("PresupuestoCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById         String?
  updatedBy           User?              @relation("PresupuestoUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  metadata            Json?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  items               PresupuestoItem[]
  invoices            Invoice[]

  @@unique([companyId, visibleNumber])
  @@unique([familyId, versionNumber], map: "uq_presupuesto_family_version")
  @@unique([familyId, id], map: "uq_presupuesto_family_id")
  @@unique([companyId, id], map: "uq_presupuesto_company_id")
  @@index([companyId, surgeryId, state])
  @@index([companyId, state])
  @@index([companyId, familyId, slot], map: "ix_presupuesto_company_family_slot")
  @@index([parentPresupuestoId])
  @@index([sourcePresupuestoId], map: "ix_presupuesto_source")
  @@map("presupuesto")
}

// ─── Facturación operacional y cobros (Fase 1D) ─────────────────────────────
// Catálogos controlados en services/validators (NO enums Prisma).
// Invoice.base ∈ presupuesto | consumo | manual | mixto.
// Invoice es operacional: sin CAE/AFIP/TusFacturasAPP productivo.
// PaymentImputation.invoiceId es FK real obligatoria (no matching por número visible/string).

model Invoice {
  id            String              @id @default(cuid())
  visibleNumber Int?
  companyId     String
  company       Company             @relation(fields: [companyId], references: [id])
  surgeryId     String?
  surgery       Surgery?            @relation(fields: [surgeryId], references: [id], onDelete: SetNull)
  presupuestoId String?
  presupuesto   Presupuesto?        @relation(fields: [presupuestoId], references: [id], onDelete: SetNull)
  consumoId     String?
  consumo       Consumo?            @relation(fields: [consumoId], references: [id], onDelete: SetNull)
  base          String              @default("manual")
  state         String              @default("Borrador")
  type          String              @default("FV")
  currency      String              @default("ARS")
  subtotal      Decimal             @default(0) @db.Decimal(18, 4)
  discountTotal Decimal             @default(0) @db.Decimal(18, 4)
  taxTotal      Decimal             @default(0) @db.Decimal(18, 4)
  total         Decimal             @default(0) @db.Decimal(18, 4)
  paidTotal     Decimal             @default(0) @db.Decimal(18, 4)
  balance       Decimal             @default(0) @db.Decimal(18, 4)
  issuedAt      DateTime?
  cancelledAt   DateTime?
  createdById   String?
  createdBy     User?               @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById   String?
  updatedBy     User?               @relation("InvoiceUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  metadata      Json?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  items         InvoiceItem[]
  imputations   PaymentImputation[]

  @@unique([companyId, visibleNumber])
  @@index([companyId, surgeryId, state])
  @@index([companyId, state])
  @@index([presupuestoId])
  @@index([consumoId])
  @@map("invoice")
}

model InvoiceItem {
  id           String   @id @default(cuid())
  invoiceId    String
  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  sku          String?
  description  String
  quantity     Decimal  @db.Decimal(18, 4)
  unit         String?
  unitPrice    Decimal  @default(0) @db.Decimal(18, 4)
  discount     Decimal  @default(0) @db.Decimal(18, 4)
  tax          Decimal  @default(0) @db.Decimal(18, 4)
  total        Decimal  @default(0) @db.Decimal(18, 4)
  sourceType   String?
  sourceItemId String?
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([invoiceId])
  @@index([sku])
  @@index([sourceType, sourceItemId])
  @@map("invoice_item")
}

model Payment {
  id            String              @id @default(cuid())
  visibleNumber Int?
  companyId     String
  company       Company             @relation(fields: [companyId], references: [id])
  surgeryId     String?
  surgery       Surgery?            @relation(fields: [surgeryId], references: [id], onDelete: SetNull)
  state         String              @default("Registrado")
  method        String?
  currency      String              @default("ARS")
  amount        Decimal             @db.Decimal(18, 4)
  receivedAt    DateTime            @default(now())
  createdById   String?
  createdBy     User?               @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById   String?
  updatedBy     User?               @relation("PaymentUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  metadata      Json?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  imputations   PaymentImputation[]

  @@unique([companyId, visibleNumber])
  @@index([companyId, surgeryId, state])
  @@index([companyId, receivedAt])
  @@map("payment")
}

model PaymentImputation {
  id        String   @id @default(cuid())
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amount    Decimal  @db.Decimal(18, 4)
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
  @@map("payment_imputation")
}

model PresupuestoItem {
  id            String      @id @default(cuid())
  presupuestoId String
  presupuesto   Presupuesto @relation(fields: [presupuestoId], references: [id], onDelete: Cascade)
  sku           String?
  description   String
  position      Int
  quantity      Decimal     @db.Decimal(18, 4)
  unit          String?
  unitPrice     Decimal     @default(0) @db.Decimal(18, 4)
  discount      Decimal     @default(0) @db.Decimal(18, 4)
  discountRate  Decimal     @default(0) @db.Decimal(9, 4)
  tax           Decimal     @default(0) @db.Decimal(18, 4)
  taxRate       Decimal     @default(0) @db.Decimal(9, 4)
  total         Decimal     @default(0) @db.Decimal(18, 4)
  metadata      Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([presupuestoId, position], map: "uq_presupuesto_item_position")
  @@index([presupuestoId])
  @@index([sku])
  @@map("presupuesto_item")
}

enum CompanyOperationalDesignation {
  PIVOT
}

enum AvailabilityRequestStatus {
  OPEN
  COMPLETED
}

enum AvailabilityCreatorResolution {
  IDENTIFIED_ELIGIBLE
  NOT_IDENTIFIED
  IDENTIFIED_INACTIVE
  IDENTIFIED_NO_COMPANY_ACCESS
}

enum AvailabilityRecipientReason {
  CREATOR
  PIVOT
}

enum AvailabilityCommandType {
  REQUEST
  COMPLETE
  CORRECT
  REASSIGN_PIVOT
}

model CompanyOperationalAssignee {
  id          String                        @id @default(cuid())
  companyId   String
  userId      String
  designation CompanyOperationalDesignation
  version     Int                           @default(1)
  createdById String
  updatedById String
  createdAt   DateTime                      @default(now())
  updatedAt   DateTime                      @updatedAt

  company    Company           @relation("AvailabilityCompanyOperationalAssignees", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_company_operational_assignee_company")
  userAccess UserCompanyAccess @relation("CompanyOperationalAssigneeUserAccess", fields: [userId, companyId], references: [userId, companyId], onDelete: Restrict, onUpdate: Cascade, map: "fk_company_operational_assignee_user_access")
  createdBy  User              @relation("CompanyOperationalAssigneeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_company_operational_assignee_created_by")
  updatedBy  User              @relation("CompanyOperationalAssigneeUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_company_operational_assignee_updated_by")

  @@unique([companyId, designation], map: "uq_company_operational_assignee_designation")
  @@index([userId, companyId], map: "ix_company_operational_assignee_user_company")
}

model AvailabilityCapabilityGrant {
  id           String    @id @default(cuid())
  companyId    String
  userId       String
  capability   String    @db.VarChar(64)
  isActive     Boolean   @default(true)
  grantedById  String
  grantedAt    DateTime  @default(now())
  revokedById  String?
  revokedAt    DateTime?
  revokeReason String?   @db.VarChar(500)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company    Company           @relation("AvailabilityCapabilityCompany", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_availability_capability_company")
  userAccess UserCompanyAccess @relation("AvailabilityCapabilityUserAccess", fields: [userId, companyId], references: [userId, companyId], onDelete: Restrict, onUpdate: Cascade, map: "fk_availability_capability_user_access")
  grantedBy  User              @relation("AvailabilityCapabilityGrantedBy", fields: [grantedById], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_availability_capability_granted_by")
  revokedBy  User?             @relation("AvailabilityCapabilityRevokedBy", fields: [revokedById], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_availability_capability_revoked_by")

  @@unique([companyId, userId, capability], map: "uq_availability_capability_grant_scope")
  @@index([companyId, capability, isActive], map: "ix_availability_capability_grant_lookup")
  @@index([userId, companyId], map: "ix_availability_capability_grant_user_company")
}

model AvailabilityRequest {
  id                    String                        @id @default(cuid())
  companyId             String
  surgeryId             String
  requesterUserId       String
  status                AvailabilityRequestStatus     @default(OPEN)
  creatorResolution     AvailabilityCreatorResolution
  creatorUserIdSnapshot String?
  creatorAuditEventId   String?
  pivotUserIdAtCreation String
  pivotMappingVersion   Int
  requestedAt           DateTime                      @default(now())
  completedAt           DateTime?
  completedByUserId     String?
  submittedDate         DateTime?                     @db.Date
  completionCommandId   String?
  correlationId         String
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt

  company             Company                                  @relation("AvailabilityCompanyRequests", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_availability_request_company")
  surgery             Surgery                                  @relation("AvailabilityRequestSurgery", fields: [companyId, surgeryId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade, map: "fk_availability_request_surgery")
  requester           User                                     @relation("AvailabilityRequester", fields: [requesterUserId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_availability_request_requester")
  completedBy         User?                                    @relation("AvailabilityCompleter", fields: [completedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_availability_request_completer")
  creatorUserSnapshot User?                                    @relation("AvailabilityCreatorUserSnapshot", fields: [creatorUserIdSnapshot], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_availability_request_creator_snapshot_user")
  pivotUserAtCreation User                                     @relation("AvailabilityPivotUserSnapshot", fields: [pivotUserIdAtCreation], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_availability_request_pivot_snapshot_user")
  creatorAuditEvent   AuditEvent?                              @relation("AvailabilityCreatorAuditEvidence", fields: [companyId, creatorAuditEventId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade, map: "fk_availability_request_creator_audit")
  completionCommand   AvailabilityCommand?                     @relation("AvailabilityRequestCompletionCommand", fields: [companyId, completionCommandId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade, map: "fk_availability_request_completion_command")
  assignments         AvailabilityRequestRecipientAssignment[] @relation("AvailabilityRequestAssignments")
  notifications       InternalNotification[]                   @relation("InternalNotificationAvailabilityRequest")
  commands            AvailabilityCommand[]                    @relation("AvailabilityCommandRequest")

  @@unique([companyId, id], map: "uq_availability_request_company_id")
  @@unique([companyId, surgeryId, id], map: "uq_availability_request_company_surgery_id")
  @@unique([companyId, completionCommandId], map: "uq_availability_request_completion_command")
  @@unique([correlationId], map: "uq_availability_request_correlation")
  @@unique([companyId, surgeryId], map: "availability_request_one_open_per_surgery", where: raw("\"status\" = 'OPEN'"))
  @@index([companyId, surgeryId, status], map: "ix_availability_request_company_surgery_status")
  @@index([companyId, requesterUserId, requestedAt], map: "ix_availability_request_company_requester_requested")
  @@index([companyId, status, requestedAt], map: "ix_availability_request_company_status_requested")
}

model AvailabilityRequestRecipientAssignment {
  id                    String                      @id @default(cuid())
  availabilityRequestId String
  companyId             String
  userId                String
  reason                AvailabilityRecipientReason
  assignedAt            DateTime                    @default(now())
  assignedByUserId      String
  revokedAt             DateTime?
  revokedByUserId       String?
  revokeReason          String?
  correlationId         String

  company    Company             @relation("AvailabilityCompanyRecipientAssignments", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_availability_assignment_company")
  request    AvailabilityRequest @relation("AvailabilityRequestAssignments", fields: [companyId, availabilityRequestId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade, map: "fk_availability_assignment_request")
  userAccess UserCompanyAccess   @relation("AvailabilityAssignmentUserAccess", fields: [userId, companyId], references: [userId, companyId], onDelete: Restrict, onUpdate: Cascade, map: "fk_availability_assignment_user_access")
  assignedBy User                @relation("AvailabilityAssignmentAssignedBy", fields: [assignedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_availability_assignment_assigned_by")
  revokedBy  User?               @relation("AvailabilityAssignmentRevokedBy", fields: [revokedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_availability_assignment_revoked_by")

  @@unique([companyId, id], map: "uq_availability_assignment_company_id")
  @@unique([availabilityRequestId, reason], map: "availability_request_one_active_reason", where: raw("\"revokedAt\" IS NULL"))
  @@unique([availabilityRequestId, reason, userId, assignedAt], map: "availability_request_assignment_episode")
  @@index([companyId, userId, revokedAt], map: "ix_availability_assignment_company_user_revoked")
  @@index([availabilityRequestId, reason, revokedAt], map: "ix_availability_assignment_request_reason_revoked")
}

model AvailabilityCommand {
  id             String                  @id @default(cuid())
  companyId      String
  actorUserId    String
  type           AvailabilityCommandType
  idempotencyKey String                  @db.VarChar(128)
  payloadHash    String                  @db.Char(64)
  requestId      String?
  surgeryId      String?
  completedAt    DateTime?
  resultCode     String?                 @db.VarChar(100)
  createdAt      DateTime                @default(now())

  company          Company              @relation("AvailabilityCompanyCommands", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_availability_command_company")
  actor            User                 @relation("AvailabilityCommandActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_availability_command_actor")
  request          AvailabilityRequest? @relation("AvailabilityCommandRequest", fields: [companyId, surgeryId, requestId], references: [companyId, surgeryId, id], onDelete: Restrict, onUpdate: Cascade, map: "fk_availability_command_request")
  surgery          Surgery?             @relation("AvailabilityCommandSurgery", fields: [companyId, surgeryId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade, map: "fk_availability_command_surgery")
  completedRequest AvailabilityRequest? @relation("AvailabilityRequestCompletionCommand")

  @@unique([companyId, id], map: "uq_availability_command_company_id")
  @@unique([companyId, actorUserId, type, idempotencyKey], map: "uq_availability_command_idempotency")
  @@index([companyId, requestId], map: "ix_availability_command_company_request")
  @@index([companyId, surgeryId], map: "ix_availability_command_company_surgery")
}

enum InternalNotificationType {
  seguimiento_mention
  availability_request_actionable
  availability_request_completed
  availability_pivot_reassigned
}

model InternalNotification {
  id                    String                   @id @default(cuid())
  companyId             String
  recipientUserId       String
  actorUserId           String
  surgeryId             String
  sourceEntityId        String
  // DB CHECK requires this link for all three availability notification types; unrelated types remain nullable.
  availabilityRequestId String?
  type                  InternalNotificationType
  eventKey              String
  title                 String
  body                  String?                  @db.Text
  metadata              Json?
  readAt                DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  company             Company              @relation(fields: [companyId], references: [id])
  recipient           User                 @relation("InternalNotificationRecipient", fields: [recipientUserId], references: [id])
  actor               User                 @relation("InternalNotificationActor", fields: [actorUserId], references: [id])
  surgery             Surgery              @relation(fields: [surgeryId], references: [id], onDelete: Cascade)
  availabilityRequest AvailabilityRequest? @relation("InternalNotificationAvailabilityRequest", fields: [companyId, surgeryId, availabilityRequestId], references: [companyId, surgeryId, id], onDelete: Restrict, onUpdate: Cascade, map: "fk_internal_notification_availability_request")

  @@unique([companyId, eventKey])
  @@index([companyId, recipientUserId, readAt, createdAt])
  @@index([recipientUserId, createdAt])
  @@index([surgeryId, createdAt])
  @@index([sourceEntityId])
  @@index([companyId, availabilityRequestId, createdAt], map: "ix_internal_notification_company_availability_request")
}

enum DigitalReceiptStatus {
  draft
  issued
  signed
  expired
  revoked
}

enum DigitalReceiptAccessStatus {
  active
  consumed
  expired
  revoked
}

enum DigitalReceiptSignerRole {
  patient
  authorized_payer
}

enum DigitalReceiptEventType {
  created
  issued
  access_created
  access_opened
  access_consumed
  signed
  snapshot_created
  artifact_created
  expired
  revoked
}

enum DigitalReceiptArtifactType {
  receipt_html
  receipt_pdf
  audit_trail
  snapshot_payload
  signature_evidence
}

enum DigitalReceiptDeliveryChannel {
  whatsapp
  email
  sms
  internal
}

model DigitalReceipt {
  id                  String                   @id @default(cuid())
  companyId           String
  surgeryId           String
  receiptNumber       String
  status              DigitalReceiptStatus
  issuedAt            DateTime
  issuedBy            Json?
  signedAt            DateTime?
  expiredAt           DateTime?
  revokedAt           DateTime?
  latestAccessVersion Int?
  activeAccessId      String?                  @unique
  currentSignerRole   DigitalReceiptSignerRole
  signers             Json
  latestSnapshotId    String?                  @unique
  metadata            Json?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  company        Company                  @relation(fields: [companyId], references: [id])
  surgery        Surgery                  @relation(fields: [surgeryId], references: [id], onDelete: Cascade)
  activeAccess   DigitalReceiptAccess?    @relation("DigitalReceiptActiveAccess", fields: [activeAccessId], references: [id])
  latestSnapshot DigitalReceiptSnapshot?  @relation("DigitalReceiptLatestSnapshot", fields: [latestSnapshotId], references: [id])
  accesses       DigitalReceiptAccess[]
  events         DigitalReceiptEvent[]
  snapshots      DigitalReceiptSnapshot[]
  artifacts      DigitalReceiptArtifact[]

  @@unique([companyId, receiptNumber])
  @@index([companyId, surgeryId])
  @@index([companyId, status])
  @@index([surgeryId, issuedAt])
}

model DigitalReceiptAccess {
  id                   String                         @id @default(cuid())
  receiptId            String
  version              Int
  status               DigitalReceiptAccessStatus
  tokenHash            String                         @unique
  tokenLastFour        String?
  channel              DigitalReceiptDeliveryChannel?
  recipientEmail       String?
  recipientPhone       String?
  signerRole           DigitalReceiptSignerRole
  signerId             String?
  issuedAt             DateTime
  activatedAt          DateTime?
  firstOpenedAt        DateTime?
  lastOpenedAt         DateTime?
  consumedAt           DateTime?
  expiredAt            DateTime?
  revokedAt            DateTime?
  supersededByAccessId String?
  metadata             Json?
  createdAt            DateTime                       @default(now())
  updatedAt            DateTime                       @updatedAt

  receipt          DigitalReceipt           @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  supersededBy     DigitalReceiptAccess?    @relation("DigitalReceiptAccessSupersession", fields: [supersededByAccessId], references: [id])
  supersedes       DigitalReceiptAccess[]   @relation("DigitalReceiptAccessSupersession")
  events           DigitalReceiptEvent[]
  artifacts        DigitalReceiptArtifact[]
  activeForReceipt DigitalReceipt[]         @relation("DigitalReceiptActiveAccess")

  @@unique([receiptId, version])
  @@index([receiptId, status])
  @@index([status, issuedAt])
}

model DigitalReceiptEvent {
  id         String                  @id @default(cuid())
  receiptId  String
  accessId   String?
  snapshotId String?
  artifactId String?
  type       DigitalReceiptEventType
  happenedAt DateTime
  actor      Json?
  detail     String?
  metadata   Json?
  createdAt  DateTime                @default(now())

  receipt  DigitalReceipt          @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  access   DigitalReceiptAccess?   @relation(fields: [accessId], references: [id], onDelete: SetNull)
  snapshot DigitalReceiptSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: SetNull)
  artifact DigitalReceiptArtifact? @relation(fields: [artifactId], references: [id], onDelete: SetNull)

  @@index([receiptId, happenedAt])
  @@index([type, happenedAt])
  @@index([accessId])
  @@index([snapshotId])
  @@index([artifactId])
}

model DigitalReceiptSnapshot {
  id         String   @id @default(cuid())
  receiptId  String
  version    Int
  capturedAt DateTime
  capturedBy Json?
  checksum   String?
  payload    Json
  metadata   Json?
  createdAt  DateTime @default(now())

  receipt          DigitalReceipt           @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  events           DigitalReceiptEvent[]
  artifacts        DigitalReceiptArtifact[]
  latestForReceipt DigitalReceipt[]         @relation("DigitalReceiptLatestSnapshot")

  @@unique([receiptId, version])
  @@index([receiptId, capturedAt])
}

model DigitalReceiptArtifact {
  id         String                     @id @default(cuid())
  receiptId  String
  snapshotId String?
  accessId   String?
  type       DigitalReceiptArtifactType
  createdAt  DateTime                   @default(now())
  createdBy  Json?
  fileName   String?
  mimeType   String?
  storageKey String?
  checksum   String?
  metadata   Json?

  receipt  DigitalReceipt          @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  snapshot DigitalReceiptSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: SetNull)
  access   DigitalReceiptAccess?   @relation(fields: [accessId], references: [id], onDelete: SetNull)
  events   DigitalReceiptEvent[]

  @@index([receiptId, createdAt])
  @@index([snapshotId])
  @@index([accessId])
  @@index([type])
}

// ─── Asignación de Contacto a Cirugía ──────────────────────────────

model SurgeryContactAssignment {
  id        String   @id @default(cuid())
  surgeryId String
  contactId String
  role      String
  isPrimary Boolean  @default(false)
  notes     String?
  createdAt DateTime @default(now())

  surgery Surgery @relation(fields: [surgeryId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id])

  @@unique([surgeryId, contactId, role])
  @@index([surgeryId])
  @@index([contactId])
}

// ─── Seguimiento de Cirugía ────────────────────────────────────────

model SeguimientoEntry {
  id          String   @id @default(cuid())
  surgeryId   String
  surgery     Surgery  @relation(fields: [surgeryId], references: [id], onDelete: Cascade)
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  entryType   String // 'note' | 'authorization_evidence' | 'file_photo_evidence' | 'mail_evidence'
  content     String   @db.Text
  summary     String?
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  evidenceRef Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([surgeryId, createdAt])
  @@index([companyId])
  @@index([entryType])
}

// ─── Auditoría ───────────────────────────────────────────────────────

model AuditEvent {
  id         String   @id @default(cuid())
  companyId  String
  userId     String
  entityType String
  entityId   String?
  action     String
  detail     String?
  oldValue   Json?
  newValue   Json?
  module     String
  metadata   Json?
  createdAt  DateTime @default(now())

  company                                Company               @relation(fields: [companyId], references: [id])
  user                                   User                  @relation(fields: [userId], references: [id])
  creatorEvidenceForAvailabilityRequests AvailabilityRequest[] @relation("AvailabilityCreatorAuditEvidence")

  stockLotObservations                     StockLotObservation[]                     @relation("StockLotObservationAudit")
  stockLotReviews                          StockLotReview[]                          @relation("StockLotReviewAudit")
  stockIdentifiedUnitConfigurationVersions StockIdentifiedUnitConfigurationVersion[] @relation("StockIdentifiedUnitConfigurationAudit")
  stockEvidence                            StockEvidence?                            @relation("StockEvidenceAudit")
  stockReservationEvidences                StockReservationEvidence[]                @relation("StockReservationEvidenceAudit")
  operationalAcceptedCommand               OperationalCommandAcceptance?             @relation("OperationalCommandAcceptanceAudit")
  operationalCommandAttempts               OperationalCommandAttempt[]               @relation("OperationalCommandAttemptAudit")
  cajasMaintenanceTransition               CajasMaintenanceTransition?               @relation("CajasMaintenanceTransitionAudit")

  @@unique([companyId, id], map: "uq_audit_event_company_id")
  @@index([entityType, entityId])
  @@index([companyId, createdAt])
  @@index([userId, createdAt])
}

// ─── Remito unificado (Fase 1A / V1 salida) ───────────────────────────
// Catálogos controlados en src/lib/validators/remito.ts (NO enums Prisma).
// origin ∈ box | presupuesto | manual | mixto
// salidaReason ∈ cirugia | venta | prestamo | traslado | ajuste | otro
// state  ∈ Borrador | Emitido | En_transito | Entregado | Parcialmente_devuelto | Devuelto | Anulado
// boxId / presupuestoId son stubs planos sin FK en V0 (FK blanda validada en service).
// branchId es nullable a nivel DB para backfill no destructivo; service/API lo exige para nuevos V1.

model Remito {
  id                       String                          @id @default(cuid())
  visibleNumber            Int? // número visible por empresa; nullable en V0, autocalculado en service
  companyId                String
  company                  Company                         @relation(fields: [companyId], references: [id])
  branchId                 String?
  branch                   Branch?                         @relation("RemitoBranch", fields: [branchId], references: [id], onDelete: SetNull)
  issuedBranchId           String?
  issuedBranch             Branch?                         @relation("RemitoIssuedBranch", fields: [issuedBranchId], references: [id], onDelete: SetNull)
  documentType             String                          @default("REMITO_SALIDA")
  surgeryId                String? // FK blanda; Remito logístico puede no tener cirugía
  surgery                  Surgery?                        @relation(fields: [surgeryId], references: [id], onDelete: SetNull)
  origin                   String // catálogo validator: box | presupuesto | manual | mixto
  salidaReason             String                          @default("cirugia")
  boxId                    String? // stub blando; FK real cuando Box lands (Fase 3)
  presupuestoId            String? // stub blando; FK real cuando Presupuesto lands (Fase 1C)
  destinatarioContactId    String?
  destinatarioSnapshot     Json? // snapshot inmutable del receptor legal
  shippingAddressSnapshot  Json? // dirección final usada para el envío; editable por remito
  transportSnapshot        Json? // transporte simple opcional V1
  packageCount             Int?
  declaredValue            Decimal?                        @db.Decimal(18, 4)
  state                    String                          @default("Borrador")
  items                    RemitoItem[]                    @relation("RemitoItemsTenant")
  consumos                 Consumo[]
  devoluciones             Devolucion[]
  scanLocator              RemitoScanLocator?              @relation("RemitoLocatorOwner")
  verificationPublications RemitoVerificationPublication[] @relation("RemitoVerificationPublications")
  issuedAt                 DateTime?
  deliveredAt              DateTime?
  returnedAt               DateTime?
  createdById              String? // FK a User; nullable para system-created remitos en V0
  createdBy                User?                           @relation("RemitoCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById              String? // último mutador; nullable
  updatedBy                User?                           @relation("RemitoUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  metadata                 Json?
  createdAt                DateTime                        @default(now())
  updatedAt                DateTime                        @updatedAt

  cajasDispatches CajasDispatch[] @relation("CajasDispatchRemito")

  @@unique([companyId, branchId, documentType, visibleNumber])
  @@unique([companyId, id], map: "uq_remito_company_id")
  @@index([companyId, surgeryId, state])
  @@index([companyId, branchId, state])
  @@index([companyId, state])
  @@index([companyId, origin])
  @@index([companyId, salidaReason])
  @@index([companyId, issuedAt])
  @@index([surgeryId])
}

model RemitoScanLocator {
  locator   String   @id(map: "pk_remito_scan_locator_locator") @db.VarChar(25)
  companyId String
  remitoId  String
  version   Int      @default(1)
  issuedAt  DateTime @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  company                  Company                         @relation("CompanyRemitoScanLocators", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  remito                   Remito                          @relation("RemitoLocatorOwner", fields: [companyId, remitoId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  verificationPublications RemitoVerificationPublication[]

  @@unique([companyId, locator])
  @@unique([companyId, remitoId])
  @@unique([companyId, locator, remitoId])
  @@index([companyId, issuedAt])
}

model RemitoVerificationPublication {
  id                        String    @id @default(cuid())
  companyId                 String
  remitoId                  String
  version                   Int
  status                    String    @default("current") @db.VarChar(16)
  currentSlot               Int?      @default(1)
  issuerDisplayNameSnapshot String    @db.VarChar(200)
  issuerTaxIdSnapshot       String    @db.VarChar(32)
  documentTypeSnapshot      String    @db.VarChar(64)
  issuedDateSnapshot        DateTime  @db.Date
  remitoShortCodeSnapshot   String    @db.VarChar(25)
  fingerprintVersion        String    @db.VarChar(8)
  fingerprintSha256         String    @db.Char(64)
  publishedAt               DateTime  @db.Timestamptz(6)
  replacedAt                DateTime? @db.Timestamptz(6)
  replacedByPublicationId   String?
  createdAt                 DateTime  @default(now()) @db.Timestamptz(6)

  company               Company                         @relation("CompanyRemitoVerificationPublications", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  remito                Remito                          @relation("RemitoVerificationPublications", fields: [companyId, remitoId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  scanLocator           RemitoScanLocator               @relation(fields: [companyId, remitoShortCodeSnapshot, remitoId], references: [companyId, locator, remitoId], onDelete: Restrict, onUpdate: Cascade)
  replacedByPublication RemitoVerificationPublication?  @relation("RemitoVerificationPublicationReplacement", fields: [companyId, replacedByPublicationId, remitoId], references: [companyId, id, remitoId], onDelete: Restrict, onUpdate: Cascade)
  replaces              RemitoVerificationPublication[] @relation("RemitoVerificationPublicationReplacement")
  accesses              RemitoVerificationAccess[]      @relation("RemitoVerificationPublicationAccesses")

  @@unique([companyId, id])
  @@unique([companyId, id, remitoId])
  @@unique([companyId, remitoId, version])
  @@unique([companyId, remitoId, currentSlot])
  @@index([companyId, remitoId, status])
  @@index([companyId, publishedAt])
}

model RemitoVerificationAccess {
  id                   String    @id @default(cuid())
  companyId            String
  remitoId             String
  publicationId        String
  version              Int
  status               String    @default("current") @db.VarChar(16)
  currentSlot          Int?      @default(1)
  tokenNonce           String    @db.Char(43)
  tokenKeyVersion      Int
  tokenHash            String    @unique @db.Char(64)
  issuedAt             DateTime  @db.Timestamptz(6)
  replacedAt           DateTime? @db.Timestamptz(6)
  revokedAt            DateTime? @db.Timestamptz(6)
  supersededByAccessId String?
  createdAt            DateTime  @default(now()) @db.Timestamptz(6)

  company            Company                       @relation("CompanyRemitoVerificationAccesses", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  publication        RemitoVerificationPublication @relation("RemitoVerificationPublicationAccesses", fields: [companyId, publicationId, remitoId], references: [companyId, id, remitoId], onDelete: Restrict, onUpdate: Cascade)
  supersededByAccess RemitoVerificationAccess?     @relation("RemitoVerificationAccessSupersession", fields: [companyId, supersededByAccessId, publicationId], references: [companyId, id, publicationId], onDelete: Restrict, onUpdate: Cascade)
  supersedes         RemitoVerificationAccess[]    @relation("RemitoVerificationAccessSupersession")

  @@unique([companyId, id])
  @@unique([companyId, id, publicationId])
  @@unique([companyId, publicationId, version])
  @@unique([companyId, publicationId, currentSlot])
  @@index([companyId, publicationId, status])
  @@index([companyId, issuedAt])
}

model PublicVerificationRateBucket {
  sourceFingerprint String    @db.Char(64)
  keyDate           DateTime  @db.Date
  firstSeenAt       DateTime  @db.Timestamptz(6)
  windowStartedAt   DateTime  @db.Timestamptz(6)
  checks            Int       @default(0)
  invalidChecks     Int       @default(0)
  blockedUntil      DateTime? @db.Timestamptz(6)
  expiresAt         DateTime  @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(6)

  @@id([sourceFingerprint, keyDate])
  @@index([expiresAt])
  @@index([blockedUntil])
}

model RemitoVerificationDailyMetric {
  id        String   @id @default(cuid())
  companyId String
  day       DateTime @db.Date
  channel   String   @db.VarChar(32)
  result    String   @db.VarChar(16)
  count     Int
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  company Company @relation("CompanyRemitoVerificationDailyMetrics", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([companyId, day, channel, result])
  @@index([day])
}

model RemitoItem {
  id                String    @id @default(cuid())
  companyId         String    @map("company_id")
  remitoId          String
  remito            Remito    @relation("RemitoItemsTenant", fields: [companyId, remitoId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade, map: "fk_remito_item_owner")
  itemId            String? // stockItemId | presupuestoItemId | catalogItemId — stub plano
  sku               String?
  description       String
  quantity          Decimal   @db.Decimal(18, 4)
  unit              String?
  boxId             String? // stub blando (item suelto distinto del remito.boxId)
  presupuestoItemId String? // stub blando para trazabilidad comparativa V1.5
  lotNumber         String?
  serialNumber      String?
  expirationDate    DateTime?
  returnedQuantity  Decimal   @default(0) @db.Decimal(18, 4)
  metadata          Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  consumoItems    ConsumoItem[]
  devolucionItems DevolucionItem[]

  cajasDispatchLines CajasDispatchLine[] @relation("CajasDispatchLineRemitoItem")

  @@unique([companyId, id], map: "uq_remito_item_company_id")
  @@unique([companyId, remitoId, id], map: "uq_remito_item_owner_id")
  @@index([remitoId])
  @@index([companyId, remitoId], map: "ix_remito_item_company_owner")
  @@index([itemId])
  @@index([presupuestoItemId])
  @@index([lotNumber])
  @@index([expirationDate])
}

// ─── Consumo (Fase 1B) ───────────────────────────────────────────────
// Catálogos controlados en src/lib/validators/consumo.ts (NO enums Prisma).
// state ∈ Borrador | Pendiente | Validado | Facturado | Anulado
// remitoId es FK OBLIGATORIA — repara conflicto C6 (consumo.remitoId no guardado en store viejo).

model Consumo {
  id            String        @id @default(cuid())
  visibleNumber Int?
  companyId     String
  company       Company       @relation(fields: [companyId], references: [id])
  surgeryId     String?
  surgery       Surgery?      @relation(fields: [surgeryId], references: [id], onDelete: SetNull)
  remitoId      String // FK OBLIGATORIA — repara conflicto C6
  remito        Remito        @relation(fields: [remitoId], references: [id], onDelete: Restrict)
  state         String        @default("Borrador") // Borrador|Pendiente|Validado|Facturado|Anulado
  items         ConsumoItem[] @relation("ConsumoItemsTenant")
  validatedAt   DateTime?
  facturedAt    DateTime?
  createdById   String?
  createdBy     User?         @relation("ConsumoCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById   String?
  updatedBy     User?         @relation("ConsumoUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  metadata      Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  devolucions   Devolucion[]
  invoices      Invoice[]

  cajasConsumptionConfirmations CajasConsumptionConfirmation[] @relation("CajasConsumptionConsumo")

  @@unique([companyId, visibleNumber])
  @@unique([companyId, id], map: "uq_consumo_company_id")
  @@unique([companyId, id, remitoId], map: "uq_consumo_id_remito")
  @@index([companyId, surgeryId, state])
  @@index([companyId, remitoId])
  @@index([companyId, state])
  @@map("consumo")
}

model ConsumoItem {
  id                String      @id @default(cuid())
  companyId         String      @map("company_id")
  consumoId         String
  consumo           Consumo     @relation("ConsumoItemsTenant", fields: [companyId, consumoId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade, map: "fk_consumo_item_owner")
  remitoItemId      String? // FK blanda al item del remito (V0 stub; FK real cuando migrate)
  remitoItem        RemitoItem? @relation(fields: [remitoItemId], references: [id])
  sku               String?
  description       String
  requestedQuantity Decimal     @db.Decimal(18, 4) // lo que el remito decía que salía
  consumedQuantity  Decimal     @default(0) @db.Decimal(18, 4) // lo que efectivamente se usó
  unit              String?
  lotNumber         String?
  serialNumber      String?
  expirationDate    DateTime?
  metadata          Json?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  devolucionItems DevolucionItem[]

  cajasConsumptionLines CajasConsumptionLine[] @relation("CajasConsumptionLineConsumoItem")

  @@unique([companyId, id], map: "uq_consumo_item_company_id")
  @@unique([companyId, consumoId, id], map: "uq_consumo_item_owner_id")
  @@index([consumoId])
  @@index([companyId, consumoId], map: "ix_consumo_item_company_owner")
  @@index([remitoItemId])
  @@index([lotNumber])
  @@index([expirationDate])
  @@map("consumo_item")
}

// ─── Devolución (Fase 1B) ────────────────────────────────────────────
// Catálogos controlados en src/lib/validators/devolucion.ts (NO enums Prisma).
// state ∈ Borrador | Pendiente | Confirmada | Rechazada | Anulada
// ENTIDAD PROPIA — NO muta Remito items aquí (separation of concerns); integra en Fase 1A.2.

model Devolucion {
  id            String           @id @default(cuid())
  visibleNumber Int?
  companyId     String
  company       Company          @relation(fields: [companyId], references: [id])
  surgeryId     String?
  surgery       Surgery?         @relation(fields: [surgeryId], references: [id], onDelete: SetNull)
  remitoId      String // FK obligatoria: la devolución siempre referencia un remito
  remito        Remito           @relation(fields: [remitoId], references: [id], onDelete: Restrict)
  consumoId     String? // FK opcional: la devolución puede venir del consumo o directa
  consumo       Consumo?         @relation(fields: [consumoId], references: [id], onDelete: SetNull)
  state         String           @default("Borrador") // Borrador|Pendiente|Confirmada|Rechazada|Anulada
  items         DevolucionItem[] @relation("DevolucionItemsTenant")
  reason        String? // motivo de la devolución
  validatedAt   DateTime? // cuándo un humano valida
  createdById   String?
  createdBy     User?            @relation("DevolucionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById   String?
  updatedBy     User?            @relation("DevolucionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  metadata      Json?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  cajasReturnConfirmations CajasReturnConfirmation[] @relation("CajasReturnDevolucion")

  @@unique([companyId, visibleNumber])
  @@unique([companyId, id], map: "uq_devolucion_company_id")
  @@unique([companyId, id, remitoId], map: "uq_devolucion_id_remito")
  @@index([companyId, surgeryId, state])
  @@index([companyId, remitoId])
  @@index([companyId, consumoId])
  @@map("devolucion")
}

model DevolucionItem {
  id               String       @id @default(cuid())
  companyId        String       @map("company_id")
  devolucionId     String
  devolucion       Devolucion   @relation("DevolucionItemsTenant", fields: [companyId, devolucionId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade, map: "fk_devolucion_item_owner")
  remitoItemId     String? // FK blanda
  remitoItem       RemitoItem?  @relation(fields: [remitoItemId], references: [id])
  consumoItemId    String? // FK blanda
  consumoItem      ConsumoItem? @relation(fields: [consumoItemId], references: [id])
  sku              String?
  description      String
  returnedQuantity Decimal      @db.Decimal(18, 4)
  unit             String?
  lotNumber        String?
  serialNumber     String?
  expirationDate   DateTime?
  metadata         Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  cajasReturnLines CajasReturnLine[] @relation("CajasReturnLineDevolucionItem")

  @@unique([companyId, id], map: "uq_devolucion_item_company_id")
  @@unique([companyId, devolucionId, id], map: "uq_devolucion_item_owner_id")
  @@index([devolucionId])
  @@index([companyId, devolucionId], map: "ix_devolucion_item_company_owner")
  @@index([remitoItemId])
  @@index([consumoItemId])
  @@index([lotNumber])
  @@index([expirationDate])
  @@map("devolucion_item")
}

