  neutralizesDispatchLine CajasDispatchLine?           @relation("CajasDispatchLineNeutralization", fields: [companyId, neutralizesDispatchLineId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade, map: "fk_cdl_neutralizes")
