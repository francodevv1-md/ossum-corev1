  stockScopeReferenceId String?                @map("stock_scope_reference_id")
  quantity              Decimal                @default(1) @map("quantity") @db.Decimal(18, 4)
  remainingQuantity     Decimal                @default(1) @map("remaining_quantity") @db.Decimal(18, 4)
  dispatchedQuantity    Decimal                @default(0) @map("dispatched_quantity") @db.Decimal(18, 4)
  activeSlot            Int?                   @default(1) @map("active_slot")
  status                StockReservationStatus @default(ACTIVE)
  semanticKey           String                 @map("semantic_key")
  createdById           String                 @map("created_by_id")
  releasedAt            DateTime?              @map("released_at") @db.Timestamptz(6)
