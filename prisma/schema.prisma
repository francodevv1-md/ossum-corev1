  articleEligibility          StockArticleEligibility      @relation("CajasConsumptionLineEligibility", fields: [companyId, articleId], references: [companyId, articleId], onDelete: Restrict, onUpdate: Cascade, map: "fk_ccln_article")
  stockPosition               StockPosition?               @relation("CajasConsumptionLineStockPosition", fields: [companyId, articleId, stockPositionId], references: [companyId, articleId, id], onDelete: Restrict, onUpdate: Cascade, map: "fk_ccln_stock_position")
  recognizedReturnDisposition CajasDisposition?            @relation("CajasConsumptionRecognizedDisposition", fields: [companyId, dispatchLineId, recognizedReturnDispositionId], references: [companyId, dispatchLineId, id], onDelete: Restrict, onUpdate: Cascade, map: "fk_ccln_recognized_disp")
