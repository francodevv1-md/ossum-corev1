model CajasDispatch {
  id                  String                  @id(map: "cajas_dispatch_pkey") @default(cuid()) @map("id")
  companyId           String                  @map("company_id")
  assignmentId        String                  @map("assignment_id")
  remitoId            String                  @map("remito_id")
  sourceControlId     String                  @map("source_control_id")
  sequence            Int                     @map("sequence")
  recordKind          CajasEvidenceRecordKind @default(original) @map("record_kind")
  correctsDispatchId  String?                 @map("corrects_dispatch_id")
  acceptedAt          DateTime                @map("accepted_at") @db.Timestamptz(6)
  acceptedById        String                  @map("accepted_by_id")
  cause               String?                 @map("cause") @db.Text
  commandAcceptanceId String                  @map("command_acceptance_id")
  createdAt           DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)

  company                  Company                        @relation("CajasCompanyDispatches", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_cdp_company")
  assignment               CajasAssignment                @relation("CajasAssignmentDispatches", fields: [companyId, assignmentId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade, map: "fk_cdp_assignment")
  remito                   Remito                         @relation("CajasDispatchRemito", fields: [companyId, remitoId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade, map: "fk_cdp_remito")
  sourceControl            CajasControl                   @relation("CajasDispatchSourceControl", fields: [companyId, sourceControlId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade, map: "fk_cdp_control")
  correctsDispatch         CajasDispatch?                 @relation("CajasDispatchCorrectionChain", fields: [companyId, correctsDispatchId, remitoId], references: [companyId, id, remitoId], onDelete: Restrict, onUpdate: Cascade, map: "fk_cdp_corrects")
  corrections              CajasDispatch[]                @relation("CajasDispatchCorrectionChain")
  acceptedBy               User                           @relation("CajasDispatchAcceptedBy", fields: [acceptedById], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_cdp_accepted_by")
  commandAcceptance        CajasCommandAcceptance         @relation("CajasCommandDispatch", fields: [companyId, commandAcceptanceId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade, map: "fk_cdp_command")
  lines                    CajasDispatchLine[]            @relation("CajasDispatchLines")
  accounting               CajasDispatchAccounting?       @relation("CajasDispatchAccounting")
  returnConfirmations      CajasReturnConfirmation[]      @relation("CajasDispatchReturns")
  consumptionConfirmations CajasConsumptionConfirmation[] @relation("CajasDispatchConsumptions")

  @@unique([companyId, id], map: "uq_cdp_company_id")
  @@unique([companyId, id, remitoId], map: "uq_cdp_owner_lineage")
  @@unique([assignmentId, sequence], map: "uq_cdp_assignment_sequence")
  @@unique([companyId, commandAcceptanceId], map: "uq_cdp_command")
  @@index([companyId, remitoId, recordKind], map: "ix_cdp_remito_kind")
  @@index([companyId, assignmentId, acceptedAt], map: "ix_cdp_assignment_time")
  @@index([sourceControlId], map: "ix_cdp_control")
  @@index([correctsDispatchId], map: "ix_cdp_corrects")
  @@map("cajas_dispatch")
}

model CajasDispatchLine {
