enum ReceiptStatus {
  PREPARED
  IN_CONTROL
  CONFIRMED
  CANCELLED
}

enum ReceiptScanStatus {
  RESOLVED
  PENDING
}

model Receipt {
  id                String        @id @default(cuid())
  companyId         String        @map("company_id")
  documentReference String?       @map("document_reference")
  supplierId        String?       @map("supplier_id")
  idempotencyKey    String?       @map("idempotency_key")
  status            ReceiptStatus @default(PREPARED)
  notes             String?       @db.Text
  metadata          Json?
  confirmedAt       DateTime?     @map("confirmed_at") @db.Timestamptz(6)
  confirmedById     String?       @map("confirmed_by_id")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  company        Company         @relation("CompanyReceipts", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  confirmedBy    User?           @relation("ReceiptConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  lines          ReceiptLine[]   @relation("ReceiptLines")
  scans          ReceiptScan[]   @relation("ReceiptScans")
  stockMovements StockMovement[] @relation("ReceiptStockMovements")

  @@unique([companyId, id], map: "uq_receipt_company_id")
  @@unique([companyId, idempotencyKey], map: "uq_receipt_idempotency", where: raw("\"idempotency_key\" IS NOT NULL"))
  @@index([companyId, status], map: "ix_receipt_company_status")
  @@index([companyId, createdAt(sort: Desc)], map: "ix_receipt_company_created")
  @@map("receipt")
}

model ReceiptLine {
  id                  String            @id @default(cuid())
  companyId           String            @map("company_id")
  receiptId           String            @map("receipt_id")
  lineNumber          Int               @map("line_number")
  articleId           String?           @map("article_id")
  expectedCode        String?           @map("expected_code")
  expectedDescription String?           @map("expected_description") @db.Text
  expectedQuantity    Decimal?          @map("expected_quantity") @db.Decimal(18, 4)
  receivedQuantity    Decimal           @default(0) @map("received_quantity") @db.Decimal(18, 4)
  lotCode             String?           @map("lot_code")
  serialNumber        String?           @map("serial_number")
  expirationDate      DateTime?         @map("expiration_date") @db.Date
  resolutionStatus    ReceiptScanStatus @default(RESOLVED) @map("resolution_status")
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  company        Company         @relation("CompanyReceiptLines", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  receipt        Receipt         @relation("ReceiptLines", fields: [companyId, receiptId], references: [companyId, id], onDelete: Cascade, onUpdate: Cascade)
  article        Article?        @relation("ArticleReceiptLines", fields: [articleId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  scans          ReceiptScan[]   @relation("ReceiptLineScans")
  stockMovements StockMovement[] @relation("ReceiptLineStockMovements")

  @@unique([companyId, id], map: "uq_receipt_line_company_id")
  @@unique([receiptId, lineNumber], map: "uq_receipt_line_receipt_number")
  @@index([companyId, receiptId], map: "ix_receipt_line_receipt")
  @@index([companyId, articleId], map: "ix_receipt_line_article")
  @@map("receipt_line")
}

model ReceiptScan {
  id               String            @id @default(cuid())
  companyId        String            @map("company_id")
  receiptId        String            @map("receipt_id")
  receiptLineId    String?           @map("receipt_line_id")
  rawValue         String            @map("raw_value") @db.Text
  resolutionStatus ReceiptScanStatus @default(RESOLVED) @map("resolution_status")
  articleId        String?           @map("article_id")
  lotCode          String?           @map("lot_code")
  serialNumber     String?           @map("serial_number")
  expirationDate   DateTime?         @map("expiration_date") @db.Date
  quantity         Decimal           @default(1) @map("quantity") @db.Decimal(18, 4)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  company     Company      @relation("CompanyReceiptScans", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  receipt     Receipt      @relation("ReceiptScans", fields: [companyId, receiptId], references: [companyId, id], onDelete: Cascade, onUpdate: Cascade)
  receiptLine ReceiptLine? @relation("ReceiptLineScans", fields: [receiptLineId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  article     Article?     @relation("ArticleReceiptScans", fields: [articleId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([companyId, id], map: "uq_receipt_scan_company_id")
  @@index([companyId, receiptId], map: "ix_receipt_scan_receipt")
  @@index([companyId, receiptLineId], map: "ix_receipt_scan_line")
  @@index([companyId, resolutionStatus], map: "ix_receipt_scan_status")
  @@map("receipt_scan")
}

