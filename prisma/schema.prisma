  stockScopeReference CajasStockScopeReference? @relation(fields: [companyId, stockScopeReferenceId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade, map: "fk_sr_stock_scope")
  createdBy           User                      @relation("StockReservationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
