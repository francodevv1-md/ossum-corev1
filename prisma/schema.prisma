  identifiedUnit                       StockIdentifiedUnit?           @relation("StockPositionIdentifiedUnit", fields: [companyId, articleId, identifiedUnitId], references: [companyId, articleId, id], onDelete: Restrict, onUpdate: Cascade, map: "fk_sp_identified_unit")
  occupancies                          StockIdentifiedUnitOccupancy[] @relation("StockIdentifiedUnitOccupancyPosition")
  activationBoundaries                 StockActivationBoundary[]      @relation("StockActivationBoundaryPosition")
  openingPositions                     StockOpeningPosition[]         @relation("StockOpeningPositionPosition")
  evidenceLinesFrom                    StockEvidenceLine[]            @relation("StockEvidenceLineFromPosition")
  evidenceLinesTo                      StockEvidenceLine[]            @relation("StockEvidenceLineToPosition")
  reservations                         StockReservation[]             @relation("StockReservationPosition")
  identifiedReservations               StockReservation[]             @relation("StockReservationIdentifiedPosition")
  positionProjection                   StockPositionProjection?       @relation("StockPositionProjectionPosition")
  compatibilityReferences              StockCompatibilityReference[]  @relation("StockCompatibilityReferencePosition")
  cajasPreparationLines                CajasPreparationLine[]         @relation("CajasPreparationLineStockPosition")
  cajasReservationCorrelations         CajasReservationCorrelation[]  @relation("CajasReservationStockPosition")
  cajasControlLines                    CajasControlLine[]             @relation("CajasControlLineStockPosition")
  priorCajasCompositionChangeLines     CajasCompositionChangeLine[]   @relation("CajasChangePriorStockPosition")
  resultingCajasCompositionChangeLines CajasCompositionChangeLine[]   @relation("CajasChangeResultStockPosition")
  cajasDispatchLines                   CajasDispatchLine[]            @relation("CajasDispatchLineStockPosition")
  cajasReturnLines                     CajasReturnLine[]              @relation("CajasReturnLineStockPosition")
  receivedCajasReplacementPairs        CajasReplacementPair[]         @relation("CajasReplacementReceivedStockPosition")
  cajasConsumptionLines                CajasConsumptionLine[]         @relation("CajasConsumptionLineStockPosition")
  cajasDispositions                    CajasDisposition[]             @relation("CajasDispositionStockPosition")

  @@unique([companyId, id], map: "uq_sp_company_id")
  @@unique([companyId, articleId, id], map: "uq_sp_company_article_id")
  @@unique([companyId, id, identifiedUnitId], map: "uq_sp_company_id_unit")
  @@unique([companyId, scopeKey], map: "uq_sp_company_scope_key")
  @@unique([companyId, articleId, policyVersionId, contextId], map: "uq_sp_none_scope", where: raw("\"traceMode\" = 'NONE'"))
  @@unique([companyId, articleId, policyVersionId, contextId, lotId], map: "uq_sp_lot_scope", where: raw("\"traceMode\" = 'LOT'"))
  @@unique([companyId, articleId, policyVersionId, contextId, identifiedUnitId], map: "uq_sp_identified_unit_scope", where: raw("\"traceMode\" = 'IDENTIFIED_UNIT'"))
  @@index([companyId, contextId, articleId], map: "ix_sp_company_context")
}

