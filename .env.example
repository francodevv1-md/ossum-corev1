# OSSUM COR — Environment variables (example)
# Copy to .env and fill with real values. Do NOT commit .env.

# ─── Supabase ────────────────────────────────────────────────────
# Base URL of your Supabase project (without /rest/v1/)
SUPABASE_URL="https://your-project.ref.supabase.co"

# Public anon key for client-side operations
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Browser/public Supabase URL alias used by the frontend auth client
NEXT_PUBLIC_SUPABASE_URL="https://your-project.ref.supabase.co"

# Browser/public anon key alias used by the frontend auth client
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Service role key for server-side admin operations (NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ─── PostgreSQL / Prisma ──────────────────────────────────────────
# Transaction pooler (port 6543) — used by the app at runtime
DATABASE_URL="postgresql://postgres.your-ref:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres"

# Session pooler (port 5432) — used by Prisma CLI for migrations
DIRECT_URL="postgresql://postgres.your-ref:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# ─── Node environment ────────────────────────────────────────────
NODE_ENV="development"

# ─── OSSUM COR public UX defaults ────────────────────────────────
# Public default company id for V0 current-user UX only; not a security boundary.
NEXT_PUBLIC_OSSUM_DEFAULT_COMPANY_ID="codev_default_company_id"

# ─── DEV-only Remito example preset (server-only; never NEXT_PUBLIC_*) ───────
# Keep disabled outside the confirmed DEV database. The route also requires
# NODE_ENV !== production and an authenticated company match.
OSSUM_ENABLE_DEV_REMITO_PRESET="false"
OSSUM_DEV_REMITO_PRESET_COMPANY_ID="confirmed_dev_company_id"

# ─── DEV-only Availability activation (server-only; never NEXT_PUBLIC_*) ─────
OSSUM_DEPLOYMENT_TIER="disabled"
OSSUM_ENABLE_AVAILABILITY_REQUESTS="false"
OSSUM_AVAILABILITY_DEV_COMPANY_ID="confirmed_dev_company_id"
OSSUM_ENABLE_AVAILABILITY_DEV_BOOTSTRAP="false"

# ─── DEV-only Remito QR/barcode verification subsystem (server-only) ──────────
# Master switch. Keep "false" everywhere except a confirmed disposable DEV DB.
# Production stays dormant; the instrumentation bootstrap refuses non-DEV tiers.
# The company id must match an active DEV company WITH a valid taxId (RF1 requires it).
# Generate a 32-byte key with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
OSSUM_ENABLE_REMITO_VERIFICATION_DEV="false"
OSSUM_REMITO_TOKEN_ACTIVE_KEY_VERSION="1"
OSSUM_REMITO_TOKEN_KEYRING_JSON='{"1":"<43-char-unpadded-base64url-32-bytes>"}'
OSSUM_REMITO_INTERNAL_ORIGIN="https://localhost:3000"
OSSUM_REMITO_PUBLIC_ORIGIN="https://localhost:3000"
OSSUM_REMITO_ACTIVATION_COMPANY_IDS="confirmed_dev_company_id"
OSSUM_REMITO_COHORT_START="2026-01-01T00:00:00.000Z"
OSSUM_REMITO_RATE_KEY_BASE64URL="<43-char-unpadded-base64url-32-bytes>"
OSSUM_REMITO_TRUSTED_FORWARDING_HEADER="forwarded"
